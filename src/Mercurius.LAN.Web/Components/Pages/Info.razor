@page "/info"
@rendermode InteractiveServer

<PageTitle>@Localization["info.pageTitle"]</PageTitle>

<section class="info-page">
    <header class="brand-page-hero info-hero brand-section">
        <div class="brand-page-hero-copy info-hero-copy">
            <h1>@Localization["General.Info.Heading"]</h1>
            <p>@Localization["General.Info.Intro"]</p>

            <SectionNav AdditionalClass="info-jump-links" AriaLabel='@Localization["General.Info.SectionsAria"]'>
                <a href="/info#packing" class="button-secondary"><span class="bi bi-backpack2" aria-hidden="true"></span> @Localization["General.Info.Pack"]</a>
                <a href="/info#where" class="button-secondary"><span class="bi bi-geo-alt" aria-hidden="true"></span> @Localization["General.Info.Where"]</a>
                <a href="/info#tickets" class="button-secondary"><span class="bi bi-ticket-perforated" aria-hidden="true"></span> @Localization["General.Info.Tickets"]</a>
                <a href="/info#catering" class="button-secondary"><span class="bi bi-cup-straw" aria-hidden="true"></span> @Localization["General.Info.Menu"]</a>
                <a href="/info#contact-info" class="button-secondary"><span class="bi bi-chat-dots" aria-hidden="true"></span> @Localization["General.Info.Contact"]</a>
            </SectionNav>
        </div>

        <aside class="brand-page-hero-panel info-hero-card" aria-label='@Localization["General.Info.QuickFactsAria"]'>
            <div class="brand-page-hero-panel-glow info-hero-card-glow" aria-hidden="true"></div>
            <span class="brand-page-hero-panel-kicker info-hero-card-kicker">@Localization["General.Info.EventBriefing"]</span>
            <strong>@Event.EventWindow</strong>
            <div class="brand-page-hero-panel-row info-hero-card-row">
                <span class="bi bi-geo-alt-fill" aria-hidden="true"></span>
                <span>@Event.VenueName</span>
            </div>
            <div class="brand-page-hero-panel-row info-hero-card-row">
                <span class="bi bi-ticket-perforated-fill" aria-hidden="true"></span>
                <span>@Localization.Get("General.Info.GamerPassesFrom", GamerTicketPrice)</span>
            </div>
            <a href="/info#tickets" class="button-primary">@Localization["General.Info.CompareTickets"]</a>
        </aside>
    </header>

    <section id="packing" class="brand-section brand-section-shell info-section brand-section-anchor">
        <div class="brand-section-shell info-section-header">
            <h2>@Localization["General.Info.PackList"]</h2>
        </div>

        <div class="packing-guide" aria-label='@Localization["General.Info.PackingGuideAria"]'>
            @foreach(var item in Event.PackingItems)
            {
                <article class="packing-item packing-item--@item.GroupKey" style="--item-index: @item.Index" aria-label="@GetPackingItemName(item)">
                    <span class="packing-item-icon bi @item.Icon" aria-hidden="true"></span>
                    <span class="packing-item-name">@GetPackingItemName(item)</span>
                    <span class="packing-item-group">@GetPackingItemGroup(item)</span>
                </article>
            }
        </div>
    </section>

    <section id="where" class="brand-section brand-section-shell info-section brand-section-anchor">
        <div class="info-location-grid">
            <article class="brand-card info-when-card">
                <h2>@Event.EventWindow</h2>
            </article>

            <article class="brand-card info-location-card">
                <h2>@Event.VenueName</h2>
                <p>@Event.Address</p>
                <a href="@Event.DirectionsUrl" target="_blank" rel="noopener noreferrer" class="button-primary">
                    <span class="bi bi-map" aria-hidden="true"></span>
                    @Localization["General.Info.OpenDirections"]
                </a>
            </article>
        </div>

        <div class="info-map-shell">
            <div class="info-map-fallback" aria-hidden="true">
                <span class="bi bi-geo-alt-fill"></span>
                <span>@Event.Address</span>
            </div>
            <iframe title='@Localization["General.Info.MapTitle"]'
                    src="@Event.MapEmbedUrl"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen>
            </iframe>
        </div>
    </section>

    <section id="tickets" class="brand-section brand-section-shell info-section brand-section-anchor">
        <div class="brand-section-shell info-section-header">
            <h2>@Localization["General.Info.PickPass"]</h2>
        </div>

        <div class="ticket-grid">
            @foreach(var ticket in Event.Tickets)
            {
                <article class="lan-ticket lan-ticket--@ticket.Kind">
                    <div class="lan-ticket-main">
                        <h3>@GetTicketName(ticket)</h3>
                        <p>@GetTicketDescription(ticket)</p>
                    </div>
                    <div class="lan-ticket-stub">
                        <strong>@GetTicketPrice(ticket.Price)</strong>
                    </div>
                </article>
            }
        </div>
    </section>

    <section id="catering" class="brand-section brand-section-shell info-section brand-section-anchor">
        <div class="menu-board">
            <div class="menu-board-header">
                <h2>@Localization["General.Info.OurMenu"]</h2>
                <p>@Localization["General.Info.MenuIntro"]</p>
            </div>

            <div class="menu-columns">
                @foreach(var menuSection in Event.MenuSections)
                {
                    <article class="menu-column">
                        <div class="menu-column-title">
                            <span class="bi @menuSection.Icon" aria-hidden="true"></span>
                            <h3>@GetMenuSectionName(menuSection.Name)</h3>
                        </div>

                        @foreach(var item in menuSection.Items)
                        {
                            <div class="menu-item">
                                <span>@GetMenuItemName(item.Name)</span>
                                <span class="menu-dots" aria-hidden="true"></span>
                                <strong>@FormatMenuPrice(item.Price)</strong>
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    </section>

    <section id="contact-info" class="brand-section brand-section-shell info-section brand-section-anchor">
        <div class="contact-grid">
            <article class="brand-card contact-card">
                <h2>@Localization["General.Info.ContactUs"]</h2>
                <EditForm Model="_contactModel" OnValidSubmit="SendContactAsync" FormName="lan-info-contact" class="info-contact-form">
                    <LocalizedDataAnnotationsValidator FieldLabelKeys="@ValidationFieldLabelKeys" />
                    <ValidationSummary />

                    <label>
                        @Localization["General.Info.Name"]
                        <InputText id="contact-name" @bind-Value="_contactModel.Name" autocomplete="name" class="form-control" />
                        <ValidationMessage For="@(() => _contactModel.Name)" />
                    </label>
                    <label>
                        @Localization["General.Info.EmailOrDiscord"]
                        <InputText id="contact-contact" @bind-Value="_contactModel.Contact" autocomplete="email" class="form-control" />
                        <ValidationMessage For="@(() => _contactModel.Contact)" />
                    </label>
                    <label>
                        @Localization["General.Info.Message"]
                        <InputTextArea id="contact-message" @bind-Value="_contactModel.Message" rows="5" class="form-control" />
                        <ValidationMessage For="@(() => _contactModel.Message)" />
                    </label>
                    <button type="submit" class="button-primary" disabled="@_isSendingContact">
                        <span class="bi bi-send" aria-hidden="true"></span>
                        @(_isSendingContact ? Localization["General.Info.Sending"] : Localization["General.Info.SendMessage"])
                    </button>
                </EditForm>
            </article>

            <aside class="social-panel">
                <h2>@Localization["General.Info.StayUpdated"]</h2>
                <div class="social-links">
                    @foreach(var link in Event.SocialLinks)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="@GetSocialLinkAriaLabel(link.AriaLabel)">
                            <span class="bi @link.Icon" aria-hidden="true"></span>
                            <span>@GetSocialLinkLabel(link.Label)</span>
                        </a>
                    }
                </div>
            </aside>
        </div>
    </section>
</section>
