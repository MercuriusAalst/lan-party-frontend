@page "/"
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Extensions
@rendermode InteractiveServer

<PageTitle>@Localization["General.Home.PageTitle"]</PageTitle>

    <section class="home-hero">
        @{
            string? primaryHeroImage = HeroTournaments.Count > 0 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[0].ImageUrl) : null;
            string? secondaryHeroImage = HeroTournaments.Count > 1 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[1].ImageUrl) : null;
            string? tertiaryHeroImage = HeroTournaments.Count > 2 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[2].ImageUrl) : null;
        }

        <div class="home-hero-shell">
            <div class="home-hero-media" aria-hidden="true">
                @if(primaryHeroImage is not null)
                {
                    <img src="@primaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--primary" />
                }

                @if(secondaryHeroImage is not null)
                {
                    <img src="@secondaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--secondary" />
                }

                @if(tertiaryHeroImage is not null)
                {
                    <img src="@tertiaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--tertiary" />
                }

                <div class="home-hero-media-glow home-hero-media-glow--green"></div>
                <div class="home-hero-media-glow home-hero-media-glow--violet"></div>
                <div class="home-hero-media-grid"></div>
            </div>

            <div class="home-hero-content">
                <img src="/img/lan_logo_wide_light.svg" alt="Mercurius LAN" class="home-hero-wordmark" />

                <h1 class="home-hero-title">@Localization["General.Home.HeroTitle"]</h1>

                <div class="home-hero-actions">
                    <a href="/info#tickets" class="button-primary">@Localization["General.Home.GetTickets"]</a>
                    <a href="/info" class="button-secondary">@Localization["General.Home.EventInfo"]</a>
                </div>

                <div class="home-hero-info-group">
                    <div class="home-hero-date-card">
                        <span class="home-hero-date-label">@Localization["General.Home.EventDate"]</span>
                        <span class="home-hero-date-value">@EventWindow</span>
                    </div>

                    <div class="home-hero-detail-row">
                        <div class="home-hero-detail-card home-hero-location-card">
                            <span class="home-hero-detail-label">@Localization["General.Home.Location"]</span>
                            <span class="home-hero-detail-value home-hero-location-value">@HeroLocation</span>
                        </div>
                    </div>
                </div>

                <a href="@(_sponsors.Any() ? "#home-sponsors" : "#home-content")" class="home-hero-scroll-link" aria-label='@Localization["General.Home.ScrollToContent"]'>
                    <span class="home-hero-scroll-label">@Localization["General.Home.ExploreEvent"]</span>
                    <span class="home-hero-scroll-indicator" aria-hidden="true"></span>
                </a>
            </div>           
        </div>
    </section>

    <div id="home-content" class="home-flow">
        <section id="home-sponsors" class="brand-section home-sponsors" aria-labelledby="home-sponsors-title">
            <div class="home-sponsors-panel brand-panel-dark">
                <div class="home-section-heading home-sponsors-heading">
                    <h2 id="home-sponsors-title" class="visually-hidden">@Localization["General.Home.OurSponsors"]</h2>
                    <a href="/sponsors" class="button-secondary home-sponsors-cta">@Localization["General.Home.ViewAllPartners"]</a>
                </div>

                @if(_isSponsorsLoading)
                {
                    <p class="home-empty-copy home-sponsors-empty" role="status">@Localization["common.loading"]</p>
                }
                else if(_sponsorsError is not null)
                {
                    <p class="home-empty-copy home-sponsors-empty" role="status">@_sponsorsError</p>
                }
                else if(_sponsors.Any())
                {
                    <div class="home-sponsors-slider">
                        <SponsorScroller Sponsors="_sponsors" AriaLabel='@Localization["General.Home.SponsorLogosAria"]' />
                    </div>
                }
                else
                {
                    <p class="home-empty-copy home-sponsors-empty">@Localization["General.Home.SponsorsEmpty"]</p>
                }
            </div>
        </section>

        <section id="featured-tournaments" class="brand-section home-tournaments" aria-labelledby="featured-tournaments-title">
            <span id="schedule" class="home-anchor-target" aria-hidden="true"></span>
            <div class="home-section-shell">
                <div class="home-section-heading">
                    <h2 id="featured-tournaments-title">@Localization["General.Home.FeaturedTournaments"]</h2>
                    <a href="/tournaments" class="button-secondary">@Localization["General.Home.ViewAllTournaments"]</a>
                </div>

                @if(_isTournamentsLoading)
                {
                    <p class="home-empty-copy" role="status">@Localization["status.loadingTournaments"]</p>
                }
                else if(_tournamentsError is not null)
                {
                    <div class="home-empty-copy" role="alert">
                        <p>@_tournamentsError</p>
                        <button type="button" class="button-primary" @onclick="RetryLoadAsync">@Localization["status.tryAgain"]</button>
                    </div>
                }
                else if(FeaturedTournaments.Count == 0)
                {
                    <p class="home-empty-copy">@Localization["General.Home.NoPublishedTournaments"]</p>
                }
                else
                {
                    var leadTournament = FeaturedTournaments[0];
                    var leadImageUrl = AssetUrlResolver.Resolve(Configuration, leadTournament.ImageUrl);
                    <div class="home-tournament-layout">
                        <button type="button" class="home-tournament-lead" @onclick="() => NavigateToTournament(leadTournament.Id)">
                            <img src="@leadImageUrl" alt="@leadTournament.Name" class="home-tournament-image home-tournament-image--lead" />
                            <span class="home-tournament-body">
                                <span class="home-tournament-meta">
                                    <strong>@leadTournament.Name</strong>
                                    <span class="tournament-status @leadTournament.Status.GetStatusClass()">@leadTournament.Status.GetStatusLabel()</span>
                                </span>
                                <span class="home-tournament-detail">@leadTournament.GetFormatDetailLabel()</span>
                            </span>
                        </button>

                        <div class="home-tournament-list">
                            @foreach(var tournament in FeaturedTournaments.Skip(1))
                            {
                                var imageUrl = AssetUrlResolver.Resolve(Configuration, tournament.ImageUrl);
                                <button type="button" class="home-tournament-row" @onclick="() => NavigateToTournament(tournament.Id)">
                                    <img src="@imageUrl" alt="" class="home-tournament-image home-tournament-image--row" />
                                    <span class="home-tournament-row-copy">
                                        <strong>@tournament.Name</strong>
                                        <span class="home-tournament-detail">@tournament.GetFormatDetailLabel()</span>
                                    </span>
                                    <span class="tournament-status @tournament.Status.GetStatusClass()">@tournament.Status.GetStatusLabel()</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <div class="home-actions">
            <section id="tickets" class="home-action-panel home-tickets" aria-labelledby="home-tickets-title">
                <div class="home-action-copy">
                    <h2 id="home-tickets-title">@Localization["General.Home.JoinLan"]</h2>
                    <p>@Localization["General.Home.ComparePasses"]</p>
                </div>
                <a href="/info#tickets" class="button-primary">@Localization["General.Home.ViewTicketInfo"]</a>
            </section>

            <section id="contact" class="home-action-panel home-contact" aria-labelledby="home-contact-title">
                <div class="home-action-copy">
                    <h2 id="home-contact-title">@Localization["General.Home.NeedMoreInfo"]</h2>
                    <p>@Localization["General.Home.FindDetails"]</p>
                </div>
                <a href="/info#contact-info" class="button-secondary">@Localization["General.Home.ContactUs"]</a>
            </section>
        </div>
    </div>
