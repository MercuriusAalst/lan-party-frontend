@using Mercurius.LAN.Web.DTOs.Search
@using Mercurius.LAN.Web.Services
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if(IsOpen)
{
    <div class="team-modal-overlay" @onclick="CancelAsync">
        <div class="team-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="invite-user-dialog-title"
             aria-describedby="invite-user-dialog-description"
             tabindex="-1"
             @ref="_dialogElement"
             @onkeydown="HandleKeyDown"
            @onclick:stopPropagation>
            <button type="button" class="team-modal-close" aria-label='@Localization["General.Team.CloseInviteDialog"]' @onclick="CancelAsync">&times;</button>
            <div class="team-modal-header">
                <span class="section-eyebrow">@Localization["General.Team.TeamInvite"]</span>
                <h3 id="invite-user-dialog-title">@Localization["General.Team.InvitePlayer"]</h3>
                <p id="invite-user-dialog-description">@Localization.Get("General.Team.InviteDescription", DisplayTeamName)</p>
            </div>

            <div class="team-dialog-form-container">
                <div class="team-dialog-form">
                    @if(!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="team-dialog-alert" role="alert">@_error</div>
                    }

                    <div class="form-group team-search-field">
                        <label for="invite-search" class="form-label">@Localization["General.Team.SearchUsername"]</label>
                        <div class="team-search-input-shell">
                            <span class="bi bi-search" aria-hidden="true"></span>
                            <input id="invite-search"
                                   class="form-control"
                                   value="@_query"
                                   @oninput="SetQueryAsync"
                                   autocomplete="off"
                                   spellcheck="false"
                                   aria-autocomplete="list"
                                   aria-expanded="@(HasSearchDropdown ? "true" : "false")"
                                   aria-controls="invite-search-results" />
                        </div>

                        @if(HasSearchDropdown)
                        {
                            <div id="invite-search-results" class="team-search-results" role="listbox" aria-label='@Localization["General.Team.UserSearchResults"]'>
                                @if(_isSearching)
                                {
                                    <div class="team-search-state" aria-live="polite">
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>@Localization["nav.searching"]</span>
                                    </div>
                                }
                                else if(_results.Count == 0)
                                {
                                    <div class="team-search-state" aria-live="polite">
                                        @Localization["General.Team.NoMatchingPlayers"]
                                    </div>
                                }
                                else
                                {
                                    @foreach(var result in _results)
                                    {
                                        var isDisabled = IsDisabledCandidate(result);
                                        <GlobalSearchResultItem Result="result"
                                                                Disabled="@isDisabled"
                                                                DisabledText="@GetDisabledCandidateText(result)"
                                                                Selected="SelectCandidateAsync"
                                                                AdditionalClass="team-search-result" />
                                    }
                                }
                            </div>
                        }
                    </div>

                    @if(_selected is { } selected)
                    {
                        <div class="team-selected-player">
                            <span class="bi bi-person-plus-fill" aria-hidden="true"></span>
                            <span>@selected.DisplayLabel</span>
                        </div>
                    }

                    <div class="team-dialog-actions">
                        <button type="button" class="button-primary" disabled="@(!CanSubmit)" @onclick="SubmitAsync">
                            <span class="bi bi-send-fill" aria-hidden="true"></span>
                            @Localization["General.Team.SendInvite"]
                        </button>
                        <button type="button" class="button-secondary" @onclick="CancelAsync">@Localization["common.cancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IUserSearchService UserSearchService { get; set; } = null!;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string TeamName { get; set; } = string.Empty;
    [Parameter] public IReadOnlySet<Guid> DisabledUserIds { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<InviteUserDialogResult> UserSelected { get; set; }
    [Parameter] public EventCallback Canceled { get; set; }

    private string _query = string.Empty;
    private bool _isSearching;
    private string? _error;
    private bool _wasOpen;
    private readonly List<GlobalSearchResultDTO> _results = [];
    private GlobalSearchResultDTO? _selected;
    private CancellationTokenSource? _searchCancellationTokenSource;
    private long _searchRequestVersion;
    private ElementReference _dialogElement;
    private IJSObjectReference? _focusTrap;

    private bool CanSubmit => _selected?.UserId.HasValue == true;
    private string DisplayTeamName => string.IsNullOrWhiteSpace(TeamName) ? Localization["General.Team.ThisTeam"] : TeamName;
    private bool HasSearchDropdown => _query.Trim().Length >= 3 && _selected is null && string.IsNullOrWhiteSpace(_error);

    protected override void OnParametersSet()
    {
        if(IsOpen && !_wasOpen)
            Reset();

        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(IsOpen && _focusTrap is null)
        {
            _focusTrap = await JSRuntime.InvokeAsync<IJSObjectReference>("activateTeamModalFocusTrap", _dialogElement);
        }
        else if(!IsOpen && _focusTrap is not null)
        {
            await DisposeFocusTrapAsync();
        }
    }

    private void Reset()
    {
        CancelPendingSearch();
        _query = string.Empty;
        _selected = null;
        _results.Clear();
        _error = null;
        _isSearching = false;
    }

    private async Task SetQueryAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _selected = null;
        _results.Clear();
        _error = null;
        CancelPendingSearch();

        var trimmedQuery = _query.Trim();
        if(trimmedQuery.Length < 3)
        {
            _isSearching = false;
            return;
        }

        _isSearching = true;
        var requestVersion = ++_searchRequestVersion;
        _searchCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _searchCancellationTokenSource.Token;
        try
        {
            var results = await UserSearchService.SearchAsync(trimmedQuery, cancellationToken);
            if(cancellationToken.IsCancellationRequested || requestVersion != _searchRequestVersion)
                return;

            _results.AddRange(results.Take(6));
        }
        catch(OperationCanceledException)
        {
        }
        catch(Exception)
        {
            if(cancellationToken.IsCancellationRequested || requestVersion != _searchRequestVersion)
                return;

            _error = Localization["General.Team.SearchUnavailable"];
        }
        finally
        {
            if(requestVersion == _searchRequestVersion)
                _isSearching = false;
        }
    }

    private void CancelPendingSearch()
    {
        _searchRequestVersion++;
        if(_searchCancellationTokenSource is null)
            return;

        _searchCancellationTokenSource.Cancel();
        _searchCancellationTokenSource.Dispose();
        _searchCancellationTokenSource = null;
    }

    private Task SelectCandidateAsync(GlobalSearchResultDTO result)
    {
        if(IsDisabledCandidate(result))
            return Task.CompletedTask;

        _selected = result;
        _query = result.DisplayLabel;
        _results.Clear();
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if(_selected?.UserId is not { } userId)
            return;

        await UserSelected.InvokeAsync(new InviteUserDialogResult(userId, _selected.DisplayLabel));
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        string.Equals(args.Key, "Escape", StringComparison.Ordinal)
            ? CancelAsync()
            : Task.CompletedTask;

    private async Task CancelAsync()
    {
        await Canceled.InvokeAsync();
    }

    private async ValueTask DisposeFocusTrapAsync()
    {
        var focusTrap = _focusTrap;
        _focusTrap = null;
        if(focusTrap is null)
            return;

        try
        {
            await focusTrap.InvokeVoidAsync("dispose");
            await focusTrap.DisposeAsync();
        }
        catch(JSDisconnectedException)
        {
        }
    }

    public ValueTask DisposeAsync() => DisposeFocusTrapAsync();

    private bool IsDisabledCandidate(GlobalSearchResultDTO result) =>
        !result.UserId.HasValue || DisabledUserIds.Contains(result.UserId.Value);

    private string? GetDisabledCandidateText(GlobalSearchResultDTO result) =>
        result.UserId.HasValue && DisabledUserIds.Contains(result.UserId.Value)
            ? Localization["General.Team.AlreadyInTeam"]
            : null;
}
