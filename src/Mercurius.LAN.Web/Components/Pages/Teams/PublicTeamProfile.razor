@page "/teams/{TeamName}"
@using Mercurius.LAN.Web.Components.Shared

@rendermode InteractiveServer

<PageTitle>@Localization["General.PublicTeam.PageTitle"]</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["status.loadingTeam"]' />
}
else if(_hasError)
{
    <StatusPage Eyebrow='@Localization["team.members"]'
                Title='@Localization["General.PublicTeam.Unavailable"]'
                Message='@Localization["General.PublicTeam.LoadError"]'
                PrimaryHref="/tournaments"
                PrimaryLabel='@Localization["common.browseTournaments"]'
                SecondaryHref="/"
                SecondaryLabel='@Localization["common.backHome"]' />
}
else if(_team is null)
{
    <StatusPage Eyebrow='@Localization["team.members"]'
                Tone="StatusPageTone.Info"
                Title='@Localization["General.PublicTeam.NotFound"]'
                Message='@Localization["General.PublicTeam.NotFoundMessage"]'
                PrimaryHref="/tournaments"
                PrimaryLabel='@Localization["common.browseTournaments"]'
                SecondaryHref="/"
                SecondaryLabel='@Localization["common.backHome"]' />
}
else
{
    <section class="public-team-page py-6 pb-12">
        <div class="public-team-shell">
            <nav class="public-team-breadcrumb" aria-label='@Localization["General.PublicTeam.Breadcrumb"]'>
                <a href="/">@Localization["nav.home"]</a>
                <span>/</span>
                <span aria-current="page">@_team.TeamName</span>
            </nav>

            <header class="brand-card public-team-hero">
                <div class="public-team-hero-identity">
                    <TeamIdentityDisplay Name="@_team.TeamName" LogoUrl="@_team.LogoUrl" Variant="hero" Size="large" ShowName="false" />
                    <div>
                        <span class="section-eyebrow">@Localization["General.PublicTeam.TeamProfile"]</span>
                        <h1>@_team.TeamName</h1>
                    </div>
                </div>
            </header>

            <div class="public-team-content-grid">
                <section id="team-roster" class="brand-card public-team-card brand-section-anchor">
                    <div class="public-team-card-heading">
                        <h2>@Localization["team.members"]</h2>
                        <p>@Localization["General.PublicTeam.PublicUsernameNotice"]</p>
                    </div>

                    @if(_team.Members.Count == 0)
                    {
                        <p class="public-team-empty">@Localization["General.PublicTeam.NoMembers"]</p>
                    }
                    else
                    {
                        <ul class="public-team-member-list">
                            @foreach(var member in _team.Members)
                            {
                                var isCaptain = !string.IsNullOrWhiteSpace(_team.CaptainUsername) &&
                                    string.Equals(member.Username, _team.CaptainUsername, StringComparison.OrdinalIgnoreCase);
                                <li>
                                    <div class="public-team-member">
                                        <span class="public-team-member-avatar" aria-hidden="true">@GetMemberInitials(member.Username)</span>
                                        <span class="public-team-member-copy">
                                            <strong>
                                                @member.Username
                                                @if(isCaptain)
                                                {
                                                    <span class="public-team-captain-badge">@Localization["team.captain"]</span>
                                                }
                                            </strong>
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section id="team-tournaments" class="brand-card public-team-card public-team-tournaments-card brand-section-anchor">
                    <div class="public-team-card-heading">
                        <h2>@Localization["General.PublicTeam.PlayingIn"]</h2>
                    </div>

                    @if(_team.Tournaments.Count == 0)
                    {
                        <p class="public-team-empty">@Localization["General.PublicTeam.NoTournaments"]</p>
                    }
                    else
                    {
                        <ul class="public-team-tournament-list">
                            @foreach(var tournament in _team.Tournaments)
                            {
                                <li>
                                    @if(tournament.TournamentId != Guid.Empty)
                                    {
                                        <a href="/tournaments/@tournament.TournamentId" class="public-team-tournament-link">
                                            <span class="bi bi-controller" aria-hidden="true"></span>
                                            <span>@tournament.Name</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="public-team-tournament-link public-team-tournament-link--unavailable">
                                            <span class="bi bi-controller" aria-hidden="true"></span>
                                            <span>@tournament.Name</span>
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div id="team-matches" class="brand-section-anchor">
                <PublicProfileMatchSummaries Summaries="@_matchSummaries"
                                             IsLoading="@_isMatchSummariesLoading"
                                             HasError="@_hasMatchSummariesError"
                                             OnRetry="RetryMatchSummariesAsync" />
            </div>
        </div>
    </section>
}
