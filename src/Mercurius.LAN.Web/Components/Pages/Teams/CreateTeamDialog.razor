@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if(IsOpen)
{
    <div class="team-modal-overlay" @onclick="CancelAsync">
        <div class="team-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="create-team-dialog-title"
             aria-describedby="create-team-dialog-description"
             tabindex="-1"
             @ref="_dialogElement"
             @onkeydown="HandleKeyDown"
            @onclick:stopPropagation>
            <button type="button" class="team-modal-close" aria-label='@Localization["General.Team.CloseCreateDialog"]' @onclick="CancelAsync">&times;</button>
            <div class="team-modal-header">
                <span id="create-team-dialog-title" class="section-eyebrow">@Localization["team.create"]</span>
                <p id="create-team-dialog-description">@Localization["General.Team.CreateDescription"]</p>
            </div>

            <div class="team-dialog-form-container">
                <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="team-dialog-form">
                    <LocalizedDataAnnotationsValidator FieldLabelKeys="@ValidationFieldLabelKeys" />

                    @if(!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="team-dialog-alert" role="alert">@_error</div>
                    }

                    <div class="form-group">
                        <label for="team-name" class="form-label">@Localization["General.Team.TeamName"]</label>
                        <InputText id="team-name" class="form-control" @bind-Value="_model.Name" maxlength="100" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </div>

                    <div class="team-dialog-logo-row">
                        <div class="team-dialog-logo-preview">
                            @if(_logo is { } logo)
                            {
                                <img src="@logo.PreviewDataUrl" alt='@Localization["General.Team.SelectedLogoPreview"]' />
                            }
                            else
                            {
                                <span class="bi bi-people-fill" aria-hidden="true"></span>
                            }
                        </div>
                        <div class="team-file-picker-group">
                            <label class="team-file-picker">
                                <span class="bi bi-image" aria-hidden="true"></span>
                                <span>@Localization["form.chooseFile"]</span>
                                <InputFile OnChange="SelectLogoAsync" accept="image/png,image/jpeg,image/webp,image/gif" />
                            </label>
                            <small>@(_logo?.FileName ?? Localization["form.noFile"])</small>
                        </div>
                    </div>

                    <div class="team-dialog-actions">
                        <button type="submit" class="button-primary">
                            <span class="bi bi-people-fill" aria-hidden="true"></span>
                            @Localization["team.create"]
                        </button>
                        <button type="button" class="button-secondary" @onclick="CancelAsync">@Localization["common.cancel"]</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private const long MaximumLogoBytes = 5 * 1024 * 1024;
    private static readonly IReadOnlyDictionary<string, string> ValidationFieldLabelKeys = new Dictionary<string, string>
    {
        [nameof(CreateTeamFormModel.Name)] = "General.Team.TeamName"
    };

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<CreateTeamDialogResult> TeamCreated { get; set; }
    [Parameter] public EventCallback Canceled { get; set; }

    private readonly CreateTeamFormModel _model = new();
    private TeamLogoSelection? _logo;
    private string? _error;
    private bool _wasOpen;
    private ElementReference _dialogElement;
    private IJSObjectReference? _focusTrap;

    protected override void OnParametersSet()
    {
        if(IsOpen && !_wasOpen)
            Reset();

        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(IsOpen && _focusTrap is null)
        {
            _focusTrap = await JSRuntime.InvokeAsync<IJSObjectReference>("activateTeamModalFocusTrap", _dialogElement);
        }
        else if(!IsOpen && _focusTrap is not null)
        {
            await DisposeFocusTrapAsync();
        }
    }

    private void Reset()
    {
        _model.Name = string.Empty;
        _logo = null;
        _error = null;
    }

    private async Task SelectLogoAsync(InputFileChangeEventArgs args)
    {
        _logo = null;
        _error = null;
        var file = args.File;
        if(file.Size > MaximumLogoBytes)
        {
            _error = Localization["General.Team.LogoTooLarge"];
            _logo = null;
            return;
        }

        if(!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _error = Localization["General.Team.ImageFileRequired"];
            _logo = null;
            return;
        }

        try
        {
            var buffer = new byte[file.Size];
            await using var stream = file.OpenReadStream(MaximumLogoBytes);
            await stream.ReadExactlyAsync(buffer);
            _logo = new TeamLogoSelection(file.Name, file.ContentType, buffer, $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}");
        }
        catch(Exception exception) when(exception is IOException or TimeoutException or JSException or OperationCanceledException)
        {
            _error = Localization["shared.fileReadFailed"];
        }
    }

    private async Task SubmitAsync()
    {
        await TeamCreated.InvokeAsync(new CreateTeamDialogResult(_model.Name.Trim(), _logo));
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        string.Equals(args.Key, "Escape", StringComparison.Ordinal)
            ? CancelAsync()
            : Task.CompletedTask;

    private async Task CancelAsync()
    {
        await Canceled.InvokeAsync();
    }

    private async ValueTask DisposeFocusTrapAsync()
    {
        var focusTrap = _focusTrap;
        _focusTrap = null;
        if(focusTrap is null)
            return;

        try
        {
            await focusTrap.InvokeVoidAsync("dispose");
            await focusTrap.DisposeAsync();
        }
        catch(JSDisconnectedException)
        {
        }
    }

    public ValueTask DisposeAsync() => DisposeFocusTrapAsync();

    private sealed class CreateTeamFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = string.Empty;
    }
}
