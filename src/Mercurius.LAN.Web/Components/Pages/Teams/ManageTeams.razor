@page "/teams/manage"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

<PageTitle>@Localization["team.manage"]</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["General.TeamManage.Loading"]' />
}
else if(!string.IsNullOrWhiteSpace(_loadError))
{
    <StatusPage Eyebrow='@Localization["General.TeamManage.Teams"]'
                Title='@Localization["General.TeamManage.Unavailable"]'
                Message="@_loadError"
                PrimaryHref="/teams/manage"
                PrimaryForceLoad="true"
                PrimaryLabel='@Localization["status.tryAgain"]'
                SecondaryHref="/tournaments"
                SecondaryLabel='@Localization["common.browseTournaments"]' />
}
else
{
    <section class="team-manage-page">
        <div id="received-invites" class="brand-section-anchor" aria-hidden="true"></div>
        @if(_summary.ReceivedPendingInvites.Count > 0)
        {
            <section class="team-invite-inbox" aria-labelledby="team-invite-heading">
                <div class="team-invite-inbox-heading">
                    <div>
                        <h2 id="team-invite-heading">@Localization["General.TeamManage.TeamInvites"]</h2>
                    </div>
                    <span class="team-count-badge">@Localization.Get("General.TeamManage.PendingCount", _summary.ReceivedPendingInvites.Count)</span>
                </div>
                <div class="team-invite-rows">
                    @foreach(var invite in _summary.ReceivedPendingInvites)
                    {
                        <article class="team-invite-row">
                            <div class="team-invite-identity">
                                <TeamIdentityDisplay Name="@invite.TeamName"
                                                     LogoUrl="@invite.TeamLogoUrl"
                                                     Href="@BuildTeamProfileHref(invite.TeamName)"
                                                     Variant="inline"
                                                     Size="small" />
                                <small>@Localization.Get("General.TeamManage.Expires", Localization.FormatDateTime(invite.ExpiresAt.ToLocalTime()))</small>
                            </div>
                            <div class="team-invite-actions">
                                <button type="button"
                                        class="team-icon-button team-icon-button--success"
                                        title='@Localization["team.accept"]'
                                        aria-label='@Localization.Get("General.TeamManage.AcceptInviteFrom", invite.TeamName)'
                                        @onclick="@(() => RespondInviteAsync(invite.Id, true))">
                                    <span class="bi bi-check-lg" aria-hidden="true"></span>
                                </button>
                                <button type="button"
                                        class="team-icon-button team-icon-button--danger"
                                        title='@Localization["team.decline"]'
                                        aria-label='@Localization.Get("General.TeamManage.DeclineInviteFrom", invite.TeamName)'
                                        @onclick="@(() => RespondInviteAsync(invite.Id, false))">
                                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        <section id="team-workspace" class="team-workspace brand-section-anchor" aria-label='@Localization["General.TeamManage.WorkspaceAria"]' data-live-updates-ready="@(_isRealtimeReady ? "true" : "false")">
            <aside class="team-selector" aria-label='@Localization["General.TeamManage.YourTeamsAria"]'>
                <div class="team-selector-heading">
                    <div class="team-selector-title">
                        <h2>@Localization["General.TeamManage.YourTeams"]</h2>
                        @if(ManageableTeams.Count > 0)
                        {
                            <span class="team-selector-count">@ManageableTeams.Count</span>
                        }
                    </div>
                    <button type="button" class="button-primary team-create-action" @onclick="OpenCreateTeamDialogAsync">
                        <span class="bi bi-plus-lg" aria-hidden="true"></span>
                        @Localization["team.create"]
                    </button>
                </div>

                @if(ManageableTeams.Count == 0)
                {
                    <div class="team-selector-empty">
                        <span class="bi bi-people" aria-hidden="true"></span>
                        <p>@Localization["General.TeamManage.NoTeam"]</p>
                    </div>
                }
                else
                {
                    <div class="team-selector-list" role="list">
                        @foreach(var team in ManageableTeams)
                        {
                            <div role="listitem">
                                <button type="button"
                                        class="@GetTeamSelectorClass(team.Id)"
                                        aria-pressed="@(_selectedTeamId == team.Id ? "true" : "false")"
                                        @onclick="@(() => SelectTeam(team.Id))">
                                    <TeamIdentityDisplay Name="@team.Name"
                                                         LogoUrl="@team.LogoUrl"
                                                         ShowName="false"
                                                         Variant="inline"
                                                         Size="large" />
                                    <span class="team-selector-copy">
                                        <strong>@team.Name</strong>
                                        <small>@GetMemberCountLabel(team.Members.Count)</small>
                                    </span>
                                    @if(IsCaptain(team))
                                    {
                                        <span class="team-role-chip">@Localization["team.captain"]</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }
            </aside>

            <main class="team-workspace-detail">
                @if(SelectedTeam is null)
                {
                    <section class="team-detail-empty">
                        <span class="bi bi-people" aria-hidden="true"></span>
                        <h2>@Localization["General.TeamManage.StartWithTeam"]</h2>
                        <p>@Localization["General.TeamManage.StartWithTeamDescription"]</p>
                    </section>
                }
                else
                {
                    var team = SelectedTeam;
                    var isCaptain = IsCaptain(team);
                    <header id="@($"team-{team.Id:N}")" class="team-detail-header brand-section-anchor">
                        <div class="team-detail-identity">
                            <TeamIdentityDisplay Name="@team.Name"
                                                 LogoUrl="@team.LogoUrl"
                                                 ShowName="false"
                                                 Variant="inline"
                                                 Size="large" />
                            <div>
                                <h2>@team.Name</h2>
                                <p>@GetTeamSummary(team, isCaptain)</p>
                            </div>
                        </div>
                        <nav class="team-tabs" aria-label='@Localization["General.TeamManage.TeamSectionsAria"]' role="tablist">
                            <button type="button"
                                    class="@GetTabClass(TeamManagementTab.Members)"
                                    role="tab"
                                    aria-selected="@(_activeTab == TeamManagementTab.Members ? "true" : "false")"
                                    aria-controls="team-roster-panel"
                                        @onclick="() => SelectTab(TeamManagementTab.Members)">@Localization["team.members"]</button>
                            @if(isCaptain)
                            {
                                <button type="button"
                                        class="@GetTabClass(TeamManagementTab.Management)"
                                        role="tab"
                                        aria-selected="@(_activeTab == TeamManagementTab.Management ? "true" : "false")"
                                        aria-controls="team-tools-panel"
                                        @onclick="() => SelectTab(TeamManagementTab.Management)">@Localization["General.TeamManage.TeamTools"]</button>
                            }
                        </nav>
                    </header>

                    @if(_activeTab == TeamManagementTab.Members)
                    {
                        <section id="team-roster-panel" class="team-members-panel" role="tabpanel" tabindex="0" aria-labelledby="team-roster-heading">
                            <div class="team-panel-heading">
                                <div>
                                    <h3 id="team-roster-heading">@Localization["General.TeamManage.TeamMembers"]</h3>
                                </div>
                                @if(isCaptain)
                                {
                                    <button type="button" class="button-primary team-toolbar-action" @onclick="() => OpenInviteDialogAsync(team.Id)">
                                        <span class="bi bi-person-plus-fill" aria-hidden="true"></span>
                                        @Localization["General.Team.InvitePlayer"]
                                    </button>
                                }
                            </div>

                            @if(team.Members.Count == 0)
                            {
                                <p class="team-inline-empty">@Localization["General.TeamManage.NoTeammates"]</p>
                            }
                            else
                            {
                                <div class="team-member-list" role="list">
                                    @foreach(var member in team.Members)
                                    {
                                        <div class="team-member-row" role="listitem">
                                            <ParticipantCardComponent Participant="ParticipantViewModel.FromUser(member)" OnParticipantSelected="SelectMemberParticipant" />
                                            <span class="team-member-role">@(member.Id == team.CaptainUserId ? Localization["team.captain"] : Localization["General.TeamManage.Member"])</span>
                                            @if(member.Id != team.CaptainUserId && isCaptain)
                                            {
                                                <button type="button"
                                                        class="team-member-remove-button"
                                                        aria-label='@Localization.Get("General.TeamManage.RemoveMemberAria", GetMemberName(member), team.Name)'
                                                        title='@Localization.Get("General.TeamManage.RemoveMemberTitle", GetMemberName(member))'
                                                        @onclick="@(() => ConfirmRemoveMemberAsync(team.Id, team.Name, member.Id, GetMemberName(member)))">
                                                    <span class="bi bi-person-dash" aria-hidden="true"></span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        @if(!isCaptain)
                        {
                            <section class="team-membership-note" aria-labelledby="team-membership-heading">
                                <div>
                                    <h3 id="team-membership-heading">@Localization["General.TeamManage.YourMembership"]</h3>
                                    <p>@Localization["General.TeamManage.MembershipDescription"]</p>
                                </div>
                                <button type="button" class="button-secondary team-danger-button" @onclick="@(() => ConfirmLeaveAsync(team.Id, team.Name))">
                                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                                    @Localization["team.leave"]
                                </button>
                            </section>
                        }
                    }
                    else if(isCaptain)
                    {
                        <section id="team-tools-panel" class="team-tools-panel" role="tabpanel" tabindex="0" aria-labelledby="team-tools-heading">
                            <div class="team-panel-heading">
                                <div>
                                    <h3 id="team-tools-heading">@Localization["General.TeamManage.CaptainTools"]</h3>
                                </div>
                                <button type="button" class="button-primary team-toolbar-action" @onclick="@(() => OpenInviteDialogAsync(team.Id))">
                                    <span class="bi bi-person-plus-fill" aria-hidden="true"></span>
                                    @Localization["General.Team.InvitePlayer"]
                                </button>
                            </div>

                            <div class="team-tools-grid">
                                <section class="team-tool" aria-labelledby="team-captain-heading">
                                    <div class="team-tool-heading">
                                        <span class="team-tool-icon team-tool-icon--accent" aria-hidden="true"><span class="bi bi-arrow-left-right"></span></span>
                                        <h4 id="team-captain-heading">@Localization["team.captain"]</h4>
                                    </div>
                                    <label class="team-form-field" for="team-captain-select-@team.Id">
                                        <span>@Localization["General.TeamManage.ChooseCaptain"]</span>
                                        <select id="team-captain-select-@team.Id" class="team-form-control" value="@GetTransferSelection(team.Id)" @onchange="args => SetTransferSelection(team.Id, args.Value?.ToString())">
                                            <option value="">@Localization["General.TeamManage.SelectTeammate"]</option>
                                            @foreach(var member in team.Members.Where(member => member.Id != team.CaptainUserId))
                                            {
                                                <option value="@member.Id">@GetMemberName(member)</option>
                                            }
                                        </select>
                                    </label>
                                    <button type="button" class="button-secondary team-tool-action" disabled="@(!GetTransferSelection(team.Id).HasValue)" @onclick="@(() => TransferCaptainAsync(team.Id))">
                                        @Localization["General.TeamManage.TransferCaptain"]
                                    </button>
                                </section>

                                <section class="team-tool" aria-labelledby="team-logo-heading">
                                    <div class="team-tool-heading">
                                        <span class="team-tool-icon team-tool-icon--soft" aria-hidden="true"><span class="bi bi-image"></span></span>
                                        <h4 id="team-logo-heading">@Localization["General.TeamManage.TeamLogo"]</h4>
                                    </div>
                                    <div class="team-logo-editor">
                                        <div class="team-logo-preview-shell">
                                            @if(GetLogoPreview(team.Id) is { } preview)
                                            {
                                                <img src="@preview" alt='@Localization["General.Team.SelectedLogoPreview"]' class="team-logo-preview" />
                                            }
                                            else if(!string.IsNullOrWhiteSpace(team.LogoUrl))
                                            {
                                                <img src="@team.LogoUrl" alt='@Localization.Get("General.TeamManage.SavedLogoAlt", team.Name)' class="team-logo-preview" />
                                            }
                                            else
                                            {
                                                <span>@GetInitials(team.Name)</span>
                                            }
                                        </div>
                                        <div class="team-file-picker-group">
                                            <label class="team-file-picker">
                                                <span class="bi bi-upload" aria-hidden="true"></span>
                                                <span>@Localization["form.chooseFile"]</span>
                                                <InputFile OnChange="@((args) => SelectLogoAsync(team.Id, args))" accept="image/png,image/jpeg,image/webp,image/gif" />
                                            </label>
                                            <small>@GetLogoFileName(team.Id)</small>
                                        </div>
                                    </div>
                                    <div class="team-logo-actions">
                                        <button type="button" class="button-primary" disabled="@(!HasSelectedLogo(team.Id))" @onclick="@(() => UploadLogoAsync(team.Id))">
                                            <span class="bi bi-check-lg" aria-hidden="true"></span>
                                            @Localization["General.TeamManage.SaveLogo"]
                                        </button>
                                        <button type="button" class="button-secondary team-danger-button" disabled="@string.IsNullOrWhiteSpace(team.LogoUrl)" @onclick="@(() => RemoveLogoAsync(team.Id))">
                                            <span class="bi bi-trash3" aria-hidden="true"></span>
                                            @Localization["General.TeamManage.RemoveLogo"]
                                        </button>
                                    </div>
                                </section>

                                <section class="team-tool" aria-labelledby="team-sent-invites-heading">
                                    <div class="team-tool-heading">
                                        <span class="team-tool-icon team-tool-icon--soft" aria-hidden="true"><span class="bi bi-send"></span></span>
                                        <h4 id="team-sent-invites-heading">@Localization["General.TeamManage.SentInvites"]</h4>
                                    </div>
                                    @if(GetSentInvites(team.Id).Count == 0)
                                    {
                                        <p class="team-inline-empty">@Localization["team.noInvites"]</p>
                                    }
                                    else
                                    {
                                        <ul class="team-sent-invite-list">
                                            @foreach(var invite in GetSentInvites(team.Id))
                                            {
                                                <li>
                                                    <span>@(invite.Username ?? Localization["General.TeamManage.InvitedPlayer"])</span>
                                                    <button type="button" class="team-text-button team-text-button--danger" @onclick="@(() => CancelInviteAsync(team.Id, invite.Id))">
                                                        <span class="bi bi-x-circle" aria-hidden="true"></span>
                                                        @Localization["common.cancel"]
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </section>

                                <section class="team-tool team-danger-zone" aria-labelledby="team-danger-heading">
                                    <div class="team-tool-heading">
                                        <span class="team-tool-icon team-tool-icon--danger" aria-hidden="true"><span class="bi bi-trash3"></span></span>
                                        <h4 id="team-danger-heading">@Localization["General.TeamManage.DeleteTeam"]</h4>
                                    </div>
                                    <button type="button" class="button-secondary team-danger-button team-tool-action" @onclick="@(() => ConfirmDeleteTeamAsync(team.Id, team.Name))">
                                        @Localization["General.TeamManage.DeleteTeam"]
                                    </button>
                                </section>
                            </div>
                        </section>
                    }
                }
            </main>
        </section>

        <CreateTeamDialog IsOpen="_isCreateTeamDialogOpen" TeamCreated="CreateTeamAsync" Canceled="CloseCreateTeamDialog" />
        <InviteUserDialog IsOpen="_isInviteDialogOpen" TeamName="@_inviteTeamName" DisabledUserIds="GetInviteDisabledUserIds()" UserSelected="InviteUserAsync" Canceled="CloseInviteDialog" />
        <UserInfoDialog User="_selectedUser" OnClose="CloseUserInfoDialog" />

        @if(_confirmation is { } confirmation)
        {
            <div class="team-modal-overlay" @onclick="CancelConfirmation">
                <div class="team-modal-dialog team-confirm-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="team-confirmation-title"
                     aria-describedby="team-confirmation-description"
                     tabindex="-1"
                     @ref="_confirmationDialogElement"
                     @onkeydown="HandleConfirmationKeyDown"
                     @onclick:stopPropagation>
                    <button type="button" class="team-modal-close" aria-label='@Localization["General.TeamManage.CloseConfirmation"]' @onclick="CancelConfirmation">&times;</button>
                    <div class="team-modal-header">
                        <span class="section-eyebrow">@confirmation.Eyebrow</span>
                        <h3 id="team-confirmation-title">@confirmation.Title</h3>
                        <p id="team-confirmation-description">@confirmation.Message</p>
                    </div>
                    <div class="team-dialog-actions">
                        <button type="button" class="button-secondary" @onclick="CancelConfirmation">@Localization["common.cancel"]</button>
                        <button type="button" class="button-primary team-danger-confirm-button" @onclick="ConfirmPendingActionAsync">
                            @confirmation.ConfirmLabel
                        </button>
                    </div>
                </div>
            </div>
        }
    </section>
}
