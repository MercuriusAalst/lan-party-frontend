@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Mercurius.LAN.Web.DTOs.Users

<PageTitle>@Localization["profile.profile"]</PageTitle>

@if(!string.IsNullOrWhiteSpace(_loadError))
{
    <StatusPage Eyebrow='@Localization["profile.profile"]'
                Title='@Localization["General.Profile.Unavailable"]'
                Message="@_loadError"
                PrimaryHref="/profile"
                PrimaryForceLoad="true"
                PrimaryLabel='@Localization["status.tryAgain"]'
                SecondaryHref="/"
                SecondaryLabel='@Localization["common.backHome"]' />
}
else if(_editContext is null)
{
    <LoadingScreen />
}
else
{
    <section class="profile-page grid gap-6 py-6 pb-12">
        <div class="profile-layout grid gap-6 lg:[grid-template-columns:minmax(0,1.4fr)_minmax(18rem,0.8fr)] lg:items-start">
            <section id="profile-details" class="brand-card profile-main-card p-4 sm:p-6 brand-section-anchor">
                <div class="profile-card-header">
                    <h2>@Localization["General.Profile.YourInformation"]</h2>
                </div>

                <div class="profile-email-row mb-5 grid gap-2">
                    <label class="form-label">@Localization["profile.email"]</label>
                    <input class="form-control" value="@_emailDisplay" disabled />
                    <div class="@_emailStatusClass profile-status-text">@_emailStatusText</div>
                </div>

                <div id="profile-security" class="profile-account-actions brand-section-anchor">
                    @if(!_emailVerified)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="ResendVerificationEmailAsync" disabled="@_isSendingVerification">@Localization["General.Profile.ResendVerification"]</button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="SendPasswordResetEmailAsync" disabled="@_isSendingPasswordReset">@Localization["General.Profile.ResetPassword"]</button>
                </div>

                <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" FormName="profile">
                    <ValidationSummary />

                    <div class="profile-form-grid grid gap-4 sm:grid-cols-1 lg:grid-cols-2">
                        <div class="form-group lg:col-span-2">
                            <label for="username">@Localization["profile.username"]</label>
                            <InputText id="username" @bind-Value="_model.Username" @onblur="CheckUsernameAvailabilityAsync" class="form-control" />
                            <ValidationMessage For="@(() => _model.Username)" />
                            @if(!string.IsNullOrWhiteSpace(_usernameAvailabilityMessage))
                            {
                                <div class="@_usernameAvailabilityClass profile-status-text">@_usernameAvailabilityMessage</div>
                            }
                        </div>

                        <div class="form-group">
                            <label for="firstname">@Localization["profile.firstName"]</label>
                            <InputText id="firstname" @bind-Value="_model.Firstname" class="form-control" />
                            <ValidationMessage For="@(() => _model.Firstname)" />
                        </div>

                        <div class="form-group">
                            <label for="lastname">@Localization["profile.lastName"]</label>
                            <InputText id="lastname" @bind-Value="_model.Lastname" class="form-control" />
                            <ValidationMessage For="@(() => _model.Lastname)" />
                        </div>

                        <div class="form-group">
                            <label for="discordId">@Localization["shared.discord"] ID</label>
                            <InputText id="discordId" @bind-Value="_model.DiscordId" class="form-control" />
                            <ValidationMessage For="@(() => _model.DiscordId)" />
                        </div>

                        <div class="form-group">
                            <label for="steamId">@Localization["shared.steam"] ID</label>
                            <InputText id="steamId" @bind-Value="_model.SteamId" class="form-control" />
                            <ValidationMessage For="@(() => _model.SteamId)" />
                        </div>

                        <div class="form-group">
                            <label for="riotId">@Localization["shared.riot"] ID</label>
                            <InputText id="riotId" @bind-Value="_model.RiotId" class="form-control" />
                            <ValidationMessage For="@(() => _model.RiotId)" />
                        </div>
                    </div>

                    <div class="form-actions-section">
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">@Localization["profile.save"]</button>
                    </div>
                </EditForm>
            </section>

            <aside class="profile-sidebar grid gap-6">
                <section id="profile-danger" class="brand-card profile-side-card profile-danger-card p-4 sm:p-6 brand-section-anchor">
                    <h2>@Localization["General.Profile.DeleteAccount"]</h2>
                    <p id="deleteConfirmHelp">@Localization.Get("General.Profile.DeleteConfirmation", _originalUsername)</p>
                    <div class="form-group">
                        <InputText id="deleteConfirm"
                                   @bind-Value="_deleteConfirmation"
                                   aria-label='@Localization["General.Profile.DeleteConfirmationAria"]'
                                   aria-describedby="deleteConfirmHelp"
                                   autocomplete="off"
                                   placeholder="@_originalUsername"
                                   class="form-control" />
                    </div>
                    <div class="form-actions-section">
                        <button type="button" class="btn btn-danger" @onclick="DeleteAccountAsync" disabled="@(!_canDelete || _isDeleting)">@Localization["General.Profile.DeleteAccount"]</button>
                    </div>
                </section>
            </aside>
        </div>
    </section>
}
