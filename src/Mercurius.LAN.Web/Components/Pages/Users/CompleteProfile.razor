@page "/complete-profile"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Mercurius.LAN.Web.DTOs.Users

<PageTitle>@(IsRegistrationFlow ? Localization["General.CompleteProfile.CreateTitle"] : Localization["auth.completeProfile"])</PageTitle>

@if(!string.IsNullOrWhiteSpace(_loadError))
{
    <StatusPage Eyebrow='@Localization["profile.profile"]'
                Title='@Localization["General.CompleteProfile.SetupUnavailable"]'
                Message="@_loadError"
                OnRetry="LoadProfileAsync"
                SecondaryHref="@GetRecoveryHref()"
                SecondaryLabel='@(IsRegistrationFlow ? Localization["General.CompleteProfile.CancelRegistration"] : Localization["common.backHome"])' />
}
else if(_isCompleted)
{
    <section class="complete-profile-page">
        <section class="brand-card complete-profile-success" role="status" aria-live="polite">
            <span class="section-eyebrow">@Localization["General.CompleteProfile.RegistrationComplete"]</span>
            <h1>@Localization["General.CompleteProfile.ReadyToPlay"]</h1>
            <p>@Localization["General.CompleteProfile.SuccessMessage"]</p>
            <button type="button" class="btn btn-primary" @onclick="ContinueAfterCompletion">@Localization["General.CompleteProfile.ContinueLan"]</button>
        </section>
    </section>
}
else if(_editContext is null)
{
    <LoadingScreen />
}
else
{
    <section class="complete-profile-page">
        <header class="complete-profile-header brand-section">
            <span class="section-eyebrow">@(IsRegistrationFlow ? Localization["General.CompleteProfile.JoinLan"] : Localization["General.CompleteProfile.AccountSetup"])</span>
            <h1>@(IsRegistrationFlow ? Localization["General.CompleteProfile.CreatePlayerProfile"] : Localization["General.CompleteProfile.CompleteYourProfile"])</h1>
            <p>@(IsRegistrationFlow ? Localization["General.CompleteProfile.RegistrationIntro"] : Localization["General.CompleteProfile.CompleteIntro"])</p>
        </header>

        <div class="complete-profile-layout">
            <section class="brand-card complete-profile-main-card">
                <div class="complete-profile-card-header">
                    <div>
                        <span class="section-eyebrow">@Localization["General.CompleteProfile.Onboarding"]</span>
                        <h2>@StepTitles[_activeStep]</h2>
                    </div>
                    <span class="complete-profile-required-note">@Localization["General.CompleteProfile.RequiredNote"]</span>
                </div>

                <ol class="complete-profile-steps" aria-label='@Localization["General.CompleteProfile.ProgressAria"]'>
                    @for(var stepIndex = 0; stepIndex < StepTitles.Length; stepIndex++)
                    {
                        <li class="@GetStepClass(stepIndex)" aria-current="@(stepIndex == _activeStep ? "step" : null)">
                            <span class="complete-profile-step-number">@(stepIndex + 1)</span>
                            <span class="complete-profile-step-copy"><strong>@StepTitles[stepIndex]</strong><small>@StepDescriptions[stepIndex]</small></span>
                        </li>
                    }
                </ol>

                <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" FormName="complete-profile">
                    <ValidationSummary />

                    @if(_activeStep == 0)
                    {
                        <div class="complete-profile-step-content">
                            @if(!string.IsNullOrWhiteSpace(_email))
                            {
                                <div class="complete-profile-email-row">
                                    <label class="form-label" for="email">@Localization["profile.email"] <small>@Localization["General.CompleteProfile.FromAccount"]</small></label>
                                    <input id="email" class="form-control" value="@_email" disabled />
                                </div>
                            }
                            <div class="form-group">
                                <label for="username">@Localization["profile.username"] <small>@Localization["General.CompleteProfile.RequiredShort"]</small></label>
                                <InputText id="username" @bind-Value="_model.Username" @onblur="CheckUsernameAvailabilityAsync" class="form-control" autocomplete="username" />
                                <ValidationMessage For="@(() => _model.Username)" />
                                @if(!string.IsNullOrWhiteSpace(_usernameAvailabilityMessage))
                                {
                                    <div class="@_usernameAvailabilityClass complete-profile-status-text" role="status">@_usernameAvailabilityMessage</div>
                                }
                                <small class="form-text">@Localization["General.CompleteProfile.UsernameHint"]</small>
                            </div>
                        </div>
                    }
                    else if(_activeStep == 1)
                    {
                        <div class="complete-profile-step-content">
                            <p class="complete-profile-help">@Localization["General.CompleteProfile.AboutHelp"]</p>
                            <div class="complete-profile-form-grid">
                                <div class="form-group"><label for="firstname">@Localization["profile.firstName"] <small>@Localization["General.CompleteProfile.RequiredShort"]</small></label><InputText id="firstname" @bind-Value="_model.Firstname" class="form-control" autocomplete="given-name" /><ValidationMessage For="@(() => _model.Firstname)" /></div>
                                <div class="form-group"><label for="lastname">@Localization["profile.lastName"] <small>@Localization["General.CompleteProfile.RequiredShort"]</small></label><InputText id="lastname" @bind-Value="_model.Lastname" class="form-control" autocomplete="family-name" /><ValidationMessage For="@(() => _model.Lastname)" /></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="complete-profile-step-content">
                            <p class="complete-profile-help">@Localization["General.CompleteProfile.GamingHelp"]</p>
                            <div class="complete-profile-form-grid">
                                <div class="form-group"><label for="discordId">@Localization["shared.discord"] ID <small>@Localization["General.CompleteProfile.OptionalShort"]</small></label><InputText id="discordId" @bind-Value="_model.DiscordId" class="form-control" autocomplete="off" /><ValidationMessage For="@(() => _model.DiscordId)" /></div>
                                <div class="form-group"><label for="steamId">@Localization["shared.steam"] ID <small>@Localization["General.CompleteProfile.OptionalShort"]</small></label><InputText id="steamId" @bind-Value="_model.SteamId" class="form-control" autocomplete="off" /><ValidationMessage For="@(() => _model.SteamId)" /></div>
                                <div class="form-group"><label for="riotId">@Localization["shared.riot"] ID <small>@Localization["General.CompleteProfile.OptionalShort"]</small></label><InputText id="riotId" @bind-Value="_model.RiotId" class="form-control" autocomplete="off" /><ValidationMessage For="@(() => _model.RiotId)" /></div>
                            </div>
                            <div class="complete-profile-review" aria-label='@Localization["General.CompleteProfile.ReviewAria"]'><span class="section-eyebrow">@Localization["General.CompleteProfile.ReadyToFinish"]</span><p><strong>@_model.Username</strong> · @_model.Firstname @_model.Lastname</p><small>@Localization["General.CompleteProfile.OptionalLater"]</small></div>
                        </div>
                    }

                    <div class="complete-profile-form-actions">
                        <div class="complete-profile-form-actions-main">
                            @if(_activeStep > 0) { <button type="button" class="btn btn-outline-secondary" @onclick="PreviousStep" disabled="@_isSaving">@Localization["common.back"]</button> }
                            @if(_activeStep < LastStepIndex) { <button type="button" class="btn btn-primary" @onclick="NextStepAsync" disabled="@_isSaving">@Localization["General.CompleteProfile.Continue"]</button> }
                            else { <button type="submit" class="btn btn-primary" disabled="@_isSaving">@(_isSaving ? Localization["General.CompleteProfile.Saving"] : Localization["General.CompleteProfile.CreateProfile"])</button> }
                        </div>
                        @if(IsRegistrationFlow)
                        {
                            <button type="button" class="btn btn-link complete-profile-cancel" @onclick="CancelOnboarding" disabled="@_isSaving">@Localization["common.cancel"]</button>
                        }
                    </div>
                </EditForm>
            </section>

            <aside class="complete-profile-sidebar">
                <section class="brand-card complete-profile-side-card"><span class="section-eyebrow">@Localization["General.CompleteProfile.WhyThisMatters"]</span><h2>@Localization["General.CompleteProfile.WhatUnlocks"]</h2><ul class="complete-profile-points"><li>@Localization["General.CompleteProfile.UsernameChecks"]</li><li>@Localization["General.CompleteProfile.CompetitionDisplays"]</li><li>@Localization["General.CompleteProfile.OptionalIds"]</li></ul></section>
            </aside>
        </div>
    </section>
}
