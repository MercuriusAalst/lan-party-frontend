@page "/users/{Username}"
@attribute [Authorize(Roles = "admin")]
@using Mercurius.LAN.Web.Components.Shared

@rendermode InteractiveServer

<PageTitle>@PageTitleText</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["status.loadingProfile"]' />
}
else if(_hasError)
{
    <StatusPage Eyebrow='@Localization["General.PublicUser.Participants"]'
                Title='@Localization["General.PublicUser.Unavailable"]'
                Message='@Localization["General.PublicUser.LoadError"]'
                PrimaryHref="/tournaments"
                PrimaryLabel='@Localization["common.browseTournaments"]'
                SecondaryHref="/"
                SecondaryLabel='@Localization["common.backHome"]' />
}
else if(_profile is null)
{
    <StatusPage Eyebrow='@Localization["General.PublicUser.Participants"]'
                Title='@Localization["General.PublicUser.NotFound"]'
                Message='@Localization["General.PublicUser.NotFoundMessage"]'
                PrimaryHref="/tournaments"
                PrimaryLabel='@Localization["common.browseTournaments"]'
                SecondaryHref="/"
                SecondaryLabel='@Localization["common.backHome"]' />
}
else
{
    <section class="public-user-page py-6 pb-12">
        <div class="public-user-shell">
            <nav class="public-profile-breadcrumb" aria-label='@Localization["General.PublicUser.Breadcrumb"]'>
                <a href="/">@Localization["nav.home"]</a>
                <span>/</span>
                <span aria-current="page">@_profile.Username</span>
            </nav>

            <header class="brand-card public-user-hero">
                <div class="public-user-hero-identity">
                    <span class="public-user-avatar" aria-hidden="true">@GetInitials(_profile)</span>
                    <div>
                        <span class="section-eyebrow">@Localization["General.PublicUser.ParticipantProfile"]</span>
                        <h1>@FullName</h1>
                        <p>@_profile.Username</p>
                    </div>
                </div>
            </header>

            <section id="profile-details" class="brand-card public-user-card brand-section-anchor">
                <div class="public-user-card-heading">
                    <h2>@Localization["General.PublicUser.ProfileDetails"]</h2>
                </div>

                <div class="public-user-identity-grid">
                    <div class="public-user-detail-panel">
                        <span class="public-user-panel-label">@Localization["profile.username"]</span>
                        <strong>@_profile.Username</strong>
                    </div>

                    <div class="public-user-detail-panel">
                        <span class="public-user-panel-label">@Localization["shared.name"]</span>
                        <strong>@FullName</strong>
                    </div>
                </div>

                @if(HasLinkedIdentities)
                {
                    <div class="public-user-linked-section">
                        <h3>@Localization["General.PublicUser.LinkedIds"]</h3>
                        <dl class="public-user-linked-grid">
                            @if(!string.IsNullOrWhiteSpace(_profile.DiscordId))
                            {
                                <div class="public-user-linked-card">
                                    <dt>
                                        <span class="bi bi-discord" aria-hidden="true"></span>
                                        Discord
                                    </dt>
                                    <dd>@_profile.DiscordId</dd>
                                </div>
                            }

                            @if(!string.IsNullOrWhiteSpace(_profile.SteamId))
                            {
                                <div class="public-user-linked-card">
                                    <dt>
                                        <span class="bi bi-steam" aria-hidden="true"></span>
                                        Steam
                                    </dt>
                                    <dd>@_profile.SteamId</dd>
                                </div>
                            }

                            @if(!string.IsNullOrWhiteSpace(_profile.RiotId))
                            {
                                <div class="public-user-linked-card">
                                    <dt>
                                        <span class="bi bi-controller" aria-hidden="true"></span>
                                        Riot
                                    </dt>
                                    <dd>@_profile.RiotId</dd>
                                </div>
                            }
                        </dl>
                    </div>
                }
            </section>

            <div id="profile-matches" class="brand-section-anchor">
                <PublicProfileMatchSummaries Summaries="@_matchSummaries"
                                             IsLoading="@_isMatchSummariesLoading"
                                             HasError="@_hasMatchSummariesError"
                                             OnRetry="RetryMatchSummariesAsync" />
            </div>
        </div>
    </section>
}
