@using Mercurius.LAN.Web.Components.Pages.Tournaments.Tabs
@implements IDisposable

<TournamentAdminRosterDialog Participant="RosterParticipant"
                             Members="RosterMembers"
                             OnClose="CloseRoster"
                             OnMemberSelected="OpenPlayerFromRosterAsync" />

<UserInfoDialog User="Player"
                OnClose="ClosePlayer"
                OnBack="@(_returnTeamId is null ? default : EventCallback.Factory.Create(this, ReturnToRoster))"
                BackLabel='@Localization["Feature.tournaments.backToTeamMembers"]' />
