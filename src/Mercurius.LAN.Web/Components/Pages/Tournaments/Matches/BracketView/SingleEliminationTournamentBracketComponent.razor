@using Mercurius.LAN.Web.Models.Matches
@rendermode InteractiveServer

<div class="bracket-root" id="bracket-root">
    @if(Tournament.Matches == null || !Tournament.Matches.Any())
    {
        <p>@Localization["status.noMatches"]</p>
    }
    else
    {
        var rounds = Tournament.Matches.GroupBy(m => m.RoundNumber).OrderBy(g => g.Key).ToList();
        int matchHeight = 60;
        int matchWidth = 220;
        int verticalGap = 32;
        int columnWidth = 260;
        int numRounds = rounds.Count;

        <div class="bracket-columns" style="min-width: @(numRounds * columnWidth)px;">
            <div class="bracket-absolute-container" style="width: @(numRounds * columnWidth)px;">
                @{
                    var roundMatches = rounds.ToDictionary(r => r.Key, r => r.OrderBy(m => m.MatchNumber).ToList());
                    int firstRound = rounds[0].Key;
                    int numFirstRoundMatches = roundMatches[firstRound].Count;
                    int reservedHeight = matchHeight + verticalGap;
                    var matchPositions = new Dictionary<(int round, int match), (int left, int y)>();
                    for(int i = 0; i < numFirstRoundMatches; i++)
                    {
                        int colX = (columnWidth - matchWidth) / 2;
                        int y = i * reservedHeight;
                        matchPositions[(firstRound, i)] = (colX, y);
                    }
                    // Round numbers can be sparse, so walk the present rounds and connect each column to the previous present one.
                    for(int column = 1; column < numRounds; column++)
                    {
                        int r = rounds[column].Key;
                        int previousRound = rounds[column - 1].Key;
                        var matches = roundMatches[r];
                        for(int i = 0; i < matches.Count; i++)
                        {
                            int colX = column * columnWidth + (columnWidth - matchWidth) / 2;
                            int srcIdx1 = i * 2;
                            int srcIdx2 = i * 2 + 1;
                            var hasSource1 = matchPositions.TryGetValue((previousRound, srcIdx1), out var source1);
                            var hasSource2 = matchPositions.TryGetValue((previousRound, srcIdx2), out var source2);
                            int y = hasSource1 && hasSource2
                                ? (source1.y + source2.y) / 2
                                : hasSource1
                                    ? source1.y
                                    : hasSource2
                                        ? source2.y
                                        : i * reservedHeight;
                            matchPositions[(r, i)] = (colX, y);
                        }
                    }
                    int svgWidth = numRounds * columnWidth;
                    int svgHeight = numFirstRoundMatches * reservedHeight - verticalGap;
                }
                <svg class="bracket-svg" width="@svgWidth" height="@svgHeight">
                    @for(int column = 1; column < numRounds; column++)
                    {
                        int r = rounds[column].Key;
                        int previousRound = rounds[column - 1].Key;
                        var matches = roundMatches[r];
                        for(int i = 0; i < matches.Count; i++)
                        {
                            int srcIdx1 = i * 2;
                            int srcIdx2 = i * 2 + 1;
                            var hasSource1 = matchPositions.TryGetValue((previousRound, srcIdx1), out var source1);
                            var hasSource2 = matchPositions.TryGetValue((previousRound, srcIdx2), out var source2);
                            int x1 = matchPositions[(r, i)].left;
                            int y1 = matchPositions[(r, i)].y + matchHeight / 2;
                            if(hasSource1)
                            {
                                int x0 = source1.left + matchWidth;
                                int y0 = source1.y + matchHeight / 2;
                                int elbowX = (x0 + x1) / 2;
                                <polyline points="@x0,@y0 @elbowX,@y0 @elbowX,@y1 @x1,@y1" fill="none" stroke="#4caf50" stroke-width="3" />
                            }
                            if(hasSource2)
                            {
                                int x0 = source2.left + matchWidth;
                                int y0 = source2.y + matchHeight / 2;
                                int elbowX = (x0 + x1) / 2;
                                <polyline points="@x0,@y0 @elbowX,@y0 @elbowX,@y1 @x1,@y1" fill="none" stroke="#4caf50" stroke-width="3" />
                            }
                        }
                    }
                </svg>
                @foreach(var round in rounds)
                {
                    int r = round.Key;
                    var matches = roundMatches[r];
                    for(int i = 0; i < matches.Count; i++)
                    {
                        var match = matches[i];
                        var pos = matchPositions[(r, i)];
                        <TournamentBracketMatchComponent OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed" Match="match" Tournament="Tournament" Position="pos"></TournamentBracketMatchComponent>
                    }
                }
            </div>
        </div>
    }
</div>
