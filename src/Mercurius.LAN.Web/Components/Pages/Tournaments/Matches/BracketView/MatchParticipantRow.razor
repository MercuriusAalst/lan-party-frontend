@rendermode InteractiveServer
@using Mercurius.LAN.Web.Models.Matches

<div class="participant-row @(_isWinner ? "winner" : "")">
    <span class="participant-name">
        @if(Participant?.Team is { } team)
        {
            <TeamIdentityDisplay Name="@team.Name" LogoUrl="@team.LogoUrl" Variant="placement" Size="compact" />
        }
        else
        {
            <UserAvatar Name="@ParticipantName" PictureUrl="@Participant?.User?.ProfilePictureUrl" Size="compact" />
            @ParticipantName
        }
    </span>
    <span class="participant-score">@CalculateParticipantScore(Match, SequenceNumber)</span>
</div>
