@rendermode InteractiveServer

@if(Tournament.Matches == null || !Tournament.Matches.Any())
{
    <p>@Localization["status.noMatches"]</p>
}
else
{
    <div class="double-elimination-shell">
        <div class="double-elimination-tabs" role="tablist" aria-label='@Localization["Feature.tournaments.bracketViewsAria"]'>
            @foreach(var option in _viewOptions)
            {
                <button
                    type="button"
                    class="double-elimination-tab @GetTabCssClass(option.View)"
                    role="tab"
                    aria-selected="@(option.View == _activeView ? "true" : "false")"
                    @onclick="@(() => SelectView(option.View))">
                    <span class="double-elimination-tab-label">@option.Label</span>
                    <span class="double-elimination-tab-meta">@option.Meta</span>
                </button>
            }
        </div>

        <section class="double-elimination-panel">
            @switch(_activeView)
            {
                case BracketView.Upper:
                    <SingleEliminationTournamentBracketComponent Tournament="@_upperBracketTournament" OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed" />
                    break;
                case BracketView.Lower:
                    @if(_lBMatches.Any())
                    {
                        var rounds = _lBMatches.GroupBy(m => m.RoundNumber).OrderBy(g => g.Key).ToList();
                        var matchData = CalculateLowerBracketLayout(rounds, _uBMatches);
                        <div class="bracket-root" id="double-elimination-bracket-root">
                            <div class="bracket-columns" style="min-width: @(matchData.SvgWidth)px;">
                                <div class="bracket-absolute-container" style="width: @(matchData.SvgWidth)px;">
                                    <svg class="bracket-svg" width="@matchData.SvgWidth" height="@matchData.SvgHeight">
                                        @((MarkupString)string.Join("", matchData.SvgElements))
                                    </svg>
                                    @foreach(var round in rounds)
                                    {
                                        foreach(var match in round.OrderBy(m => m.MatchNumber))
                                        {
                                            if(matchData.MatchPositions.TryGetValue(match.Id, out var pos))
                                            {
                                                <TournamentBracketMatchComponent Match="match" Tournament="Tournament" Position="pos" OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed"></TournamentBracketMatchComponent>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    break;
                case BracketView.GrandFinal:
                    @if(_gFMatch != null)
                    {
                        <div class="double-elimination-finals-card">
                            <TournamentBracketMatchComponent Match="_gFMatch" Tournament="Tournament" ExtraCssClasses="relative" OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed" />
                        </div>
                    }
                    break;
            }
        </section>
    </div>
}
