@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Matches
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Matches
@using Microsoft.AspNetCore.Components.Authorization

@rendermode InteractiveServer

<CascadingValue Value="Match">
    <div class="match-modal-overlay" @onclick="OnClose">
        <div class="match-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="match-dialog-title" @onclick:stopPropagation>
            <button type="button" class="match-modal-close" aria-label='@Localization["Feature.match.closeDetails"]' @onclick="OnClose">&times;</button>

            <div class="match-modal-header">
                <span class="section-eyebrow">@Localization["Feature.match.details"]</span>
                <h2 id="match-dialog-title" class="match-header">
                    <span class="match-header-name">
                        @if(HeaderParticipant1?.Team is { } team1)
                        {
                            <TeamIdentityDisplay Name="@team1.Name" LogoUrl="@team1.LogoUrl" Href="@BuildTeamProfileHref(team1.Name)" Variant="inline" Size="small" />
                        }
                        else
                        {
                            @Participant1Name
                        }
                        <span class="match-header-score">[@(Match.Participant1Score?.ToString() ?? "?")]</span>
                    </span>
                    <span class="match-header-vs">@Localization["Feature.match.vs"]</span>
                    <span class="match-header-name">
                        @if(HeaderParticipant2?.Team is { } team2)
                        {
                            <TeamIdentityDisplay Name="@team2.Name" LogoUrl="@team2.LogoUrl" Href="@BuildTeamProfileHref(team2.Name)" Variant="inline" Size="small" />
                        }
                        else
                        {
                            @Participant2Name
                        }
                        <span class="match-header-score">[@(Match.Participant2Score?.ToString() ?? "?")]</span>
                    </span>
                </h2>
                <div class="match-summary-badges">
                    <span class="badge">@GetStageLabel()</span>
                    <span class="badge">@GetRoundLabel()</span>
                    <span class="badge">@GetFormatLabel()</span>
                    <span class="match-status-pill @GetStatusClass()">@GetStatusLabel()</span>
                </div>
                <div class="match-start-time">
                    <span>@Localization["Feature.match.startTime"]</span>
                    <strong>@GetStartDateTimeLabel()</strong>
                </div>
            </div>

            <section class="match-lifecycle-panel">
                <div>
                    <h3>@GetStatusLabel()</h3>
                    <p>@GetStatusDescription()</p>
                </div>
                @if(!string.IsNullOrWhiteSpace(GetDeadlineLabel()))
                {
                    <div class="match-deadline" aria-label='@Localization["Feature.match.deadlineAria"]'>
                        <span>@Localization["Feature.match.deadline"]</span>
                        <strong>@GetDeadlineLabel()</strong>
                        <small aria-live="off">@GetDeadlineRemainingLabel()</small>
                    </div>
                }
            </section>

            @if(_isLoading && !_hasLoaded)
            {
                <div class="match-state-message" role="status">@Localization["Feature.match.loading"]</div>
            }
            else if(_errorMessage is not null)
            {
                <div class="match-state-message match-state-message--error" role="alert">
                    <p>@_errorMessage</p>
                    <button type="button" class="button-secondary" disabled="@_isLoading" @onclick="RetryAsync">@Localization["status.tryAgain"]</button>
                </div>
            }

            @if(_isLoading && _hasLoaded)
            {
                <div class="match-refresh-message" role="status">@Localization["Feature.match.updating"]</div>
            }

            <div class="participants-grid">
                <section class="@GetCardClass(Participant1Id)">
                    @if(IsWinner(Participant1Id) || (WinnerId != null && Participant1Id != null))
                    {
                        <div class="match-participant-panel-header">
                            @if(IsWinner(Participant1Id))
                            {
                                <span class="match-outcome-chip match-outcome-chip--winner">@Localization["Feature.match.winner"]</span>
                            }
                            else
                            {
                                <span class="match-outcome-chip match-outcome-chip--loser">@Localization["Feature.match.loser"]</span>
                            }
                        </div>
                    }
                    <ParticipantComponent Participant="GetParticipantById(Participant1Id)" EmptyLabel="@GetEmptyParticipantLabel(Match.Participant1IsBYE)" CanViewUserDetails="@CanViewParticipant1Details" OnUserSelected="DisplayUserPopup" />
                    @if(_hasLoaded)
                    {
                        <div class="match-confirmation-status">
                            <span>@Localization["Feature.match.matchEnded"]</span>
                            <strong>@GetEndedStatusLabel(Match.Participant1Ended)</strong>
                        </div>
                    }
                </section>
                <section class="@GetCardClass(Participant2Id)">
                    @if(IsWinner(Participant2Id) || (WinnerId != null && Participant2Id != null))
                    {
                        <div class="match-participant-panel-header">
                            @if(IsWinner(Participant2Id))
                            {
                                <span class="match-outcome-chip match-outcome-chip--winner">@Localization["Feature.match.winner"]</span>
                            }
                            else
                            {
                                <span class="match-outcome-chip match-outcome-chip--loser">@Localization["Feature.match.loser"]</span>
                            }
                        </div>
                    }
                    <ParticipantComponent Participant="GetParticipantById(Participant2Id)" EmptyLabel="@GetEmptyParticipantLabel(Match.Participant2IsBYE)" CanViewUserDetails="@CanViewParticipant2Details" OnUserSelected="DisplayUserPopup" />
                    @if(_hasLoaded)
                    {
                        <div class="match-confirmation-status">
                            <span>@Localization["Feature.match.matchEnded"]</span>
                            <strong>@GetEndedStatusLabel(Match.Participant2Ended)</strong>
                        </div>
                    }
                </section>
            </div>

            @if(_isLoadingOpponentProfile)
            {
                <div class="match-state-message" role="status">@Localization["Feature.match.loading"]</div>
            }
            else if(_opponentProfileError is not null)
            {
                <div class="match-state-message match-state-message--error" role="status">@_opponentProfileError</div>
            }

            @if(_requiresAuthentication)
            {
                <div class="match-state-message" role="note">
                    <p>@Localization["Feature.match.signInToManage"]</p>
                    <a class="button-secondary" href="@SignInHref">@Localization["auth.signIn"]</a>
                </div>
            }
            else if(_hasFreshActionState && _actionState?.AuthorizedParticipant.HasValue == true)
            {
                <section class="match-action-panel" aria-label='@Localization["Feature.match.yourActionsAria"]'>
                    <span class="section-eyebrow">@ActionSubjectLabel</span>
                    @if(_actionState.CanConfirmEnded)
                    {
                        <p>@Localization["Feature.match.confirmEndedHelp"]</p>
                        <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoading)" @onclick="ConfirmEndedAsync">@Localization["Feature.match.confirmEnded"]</button>
                    }
                    @if(ShowPrivateReports && (PrivateReport1.HasValue || PrivateReport2.HasValue))
                    {
                        <div class="match-reports" aria-label='@Localization["Feature.match.privateReportsAria"]'>
                            @if(_actionState.AuthorizedParticipant.HasValue)
                            {
                                <span>@Localization["Feature.match.yourReport"] @FormatReport(OwnReport1, OwnReport2)</span>
                                <span>@Localization["Feature.match.opponentReport"] @FormatReport(OpponentReport1, OpponentReport2)</span>
                            }
                            else
                            {
                                <span>@Localization["Feature.match.participantOneReport"] @FormatReport(_actionState.Participant1ReportedScore1, _actionState.Participant1ReportedScore2)</span>
                                <span>@Localization["Feature.match.participantTwoReport"] @FormatReport(_actionState.Participant2ReportedScore1, _actionState.Participant2ReportedScore2)</span>
                            }
                        </div>
                    }
                    @if(_actionState.CanSubmitScore)
                    {
                        <div class="match-score-editor">
                            <div class="match-score-editor-copy">
                                <h3>@Localization["Feature.match.reportFinalScore"]</h3>
                                <p>@Localization["Feature.match.reportFinalScoreHelp"]</p>
                            </div>
                            <div class="score-inputs">
                                <div class="match-score-field">
                                    <label for="participant1-score">@Participant1Name</label>
                                    <input id="participant1-score" type="number" min="0" class="form-control score-input" disabled="@(_isSubmitting || _isLoading)" @bind="_participant1Score" />
                                </div>
                                <div class="match-score-field">
                                    <label for="participant2-score">@Participant2Name</label>
                                    <input id="participant2-score" type="number" min="0" class="form-control score-input" disabled="@(_isSubmitting || _isLoading)" @bind="_participant2Score" />
                                </div>
                            </div>
                            <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoading || !HasScoreInputs)" @onclick="SubmitScoreAsync">@Localization["Feature.match.submitScore"]</button>
                        </div>
                    }
                    @if(_actionState.CanForfeit)
                    {
                        @if(!_forfeitConfirmationRequested)
                        {
                            <button type="button" class="button-secondary button-danger" disabled="@(_isSubmitting || _isLoading)" @onclick="(() => _forfeitConfirmationRequested = true)">@Localization["Feature.match.forfeitYourSide"]</button>
                        }
                        else
                        {
                            <div class="match-confirmation-box" role="alertdialog" aria-label='@Localization["Feature.match.confirmForfeitAria"]' aria-modal="true">
                                <strong>@Localization["Feature.match.forfeitThisMatch"]</strong>
                                <p>@Localization["Feature.match.forfeitWarning"]</p>
                                <div class="match-modal-actions">
                                    <button type="button" class="button-secondary" disabled="@_isSubmitting" @onclick="(() => _forfeitConfirmationRequested = false)">@Localization["Feature.match.keepPlaying"]</button>
                                    <button type="button" class="button-danger" disabled="@_isSubmitting" @onclick="ForfeitOwnSideAsync">@Localization["Feature.match.confirmForfeit"]</button>
                                </div>
                            </div>
                        }
                    }
                </section>
            }
            <AuthorizeView Roles="admin">
                <Authorized>
                    @if(_hasFreshActionState && _actionState is not null)
                    {
                    <section class="match-action-panel match-action-panel--admin" aria-label='@Localization["Feature.match.adminActionsAria"]'>
                        <span class="section-eyebrow">@Localization["Feature.match.adminControls"]</span>
                        @if(IsAdminResolutionState())
                        {
                            @if(ShouldRenderAdminReports(_actionState))
                            {
                                <div class="match-reports" aria-label='@Localization["Feature.match.privateReportsAria"]'>
                                    <span>@Localization["Feature.match.participantOneReport"] @FormatReport(_actionState.Participant1ReportedScore1, _actionState.Participant1ReportedScore2)</span>
                                    <span>@Localization["Feature.match.participantTwoReport"] @FormatReport(_actionState.Participant2ReportedScore1, _actionState.Participant2ReportedScore2)</span>
                                </div>
                            }
                            @if(_actionState.CanResolve)
                            {
                                <p>@Localization["Feature.match.resolveHelp"]</p>
                                @if(!HasScoreInputs)
                                {
                                    <p class="match-admin-blocked-reason">@Localization["Feature.match.enterScoresBeforeResolve"]</p>
                                }
                            }
                            else
                            {
                                <p class="match-admin-blocked-reason">@GetLocalizedAdminBlockedReason(_actionState.ResolveBlockedReason)</p>
                            }
                            @if(_actionState.CanResolve)
                            {
                            <div class="score-inputs">
                                <div class="match-score-field">
                                    <label for="admin-participant1-score">@Participant1Name</label>
                                    <input id="admin-participant1-score" type="number" min="0" class="form-control score-input" disabled="@(_isSubmitting || _isLoading)" @bind="_participant1Score" />
                                </div>
                                <div class="match-score-field">
                                    <label for="admin-participant2-score">@Participant2Name</label>
                                    <input id="admin-participant2-score" type="number" min="0" class="form-control score-input" disabled="@(_isSubmitting || _isLoading)" @bind="_participant2Score" />
                                </div>
                            </div>
                            <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoading || !_actionState.CanResolve || !HasScoreInputs)" @onclick="ResolveAsync">@Localization["Feature.match.resolveResult"]</button>
                            }
                        }
                        @if(_actionState.CanForceForfeit)
                        {
                            <div class="match-admin-forfeit-actions">
                                <span>@Localization["Feature.match.recordForfeit"]</span>
                                <button type="button" class="button-secondary button-danger" disabled="@(_isSubmitting || _isLoading)" @onclick="(() => RequestAdminForfeitAsync(MatchParticipantSide.Participant1))">@Localization.Get("Feature.match.forfeitParticipant", Participant1Name)</button>
                                <button type="button" class="button-secondary button-danger" disabled="@(_isSubmitting || _isLoading)" @onclick="(() => RequestAdminForfeitAsync(MatchParticipantSide.Participant2))">@Localization.Get("Feature.match.forfeitParticipant", Participant2Name)</button>
                            </div>
                        }
                        @if(_adminForfeitConfirmationSide is MatchParticipantSide adminForfeitSide)
                        {
                            <div class="match-confirmation-box" role="alertdialog" aria-label='@Localization["Feature.match.confirmAdminForfeitAria"]' aria-modal="true">
                                <strong>@Localization.Get("Feature.match.forfeitParticipantQuestion", GetParticipantName(adminForfeitSide))</strong>
                                <p>@Localization["Feature.match.adminForfeitWarning"]</p>
                                <div class="match-modal-actions">
                                    <button type="button" class="button-secondary" disabled="@_isSubmitting" @onclick="(() => _adminForfeitConfirmationSide = null)">@Localization["common.cancel"]</button>
                                    <button type="button" class="button-danger" disabled="@_isSubmitting" @onclick="(() => ForfeitSideAsAdminAsync(adminForfeitSide))">@Localization["Feature.match.confirmForfeit"]</button>
                                </div>
                            </div>
                        }
                        @if(_actionState.CanForceForfeit == false && !string.IsNullOrWhiteSpace(_actionState.ForceForfeitBlockedReason) && Match.LifecycleState is not (MatchLifecycleState.Completed or MatchLifecycleState.Forfeited))
                        {
                            <p class="match-admin-blocked-reason">@GetLocalizedAdminBlockedReason(_actionState.ForceForfeitBlockedReason)</p>
                        }
                        @if(_actionState.CanReverse)
                        {
                            @if(!_reverseConfirmationRequested)
                            {
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoading)" @onclick="(() => _reverseConfirmationRequested = true)">@Localization["Feature.match.reverseOfficialResult"]</button>
                            }
                            else
                            {
                                <div class="match-confirmation-box" role="alertdialog" aria-label='@Localization["Feature.match.confirmReversalAria"]' aria-modal="true">
                                    <strong>@Localization["Feature.match.reverseThisResult"]</strong>
                                    <p>@Localization["Feature.match.reverseWarning"]</p>
                                    <div class="match-modal-actions">
                                        <button type="button" class="button-secondary" disabled="@_isSubmitting" @onclick="(() => _reverseConfirmationRequested = false)">@Localization["common.cancel"]</button>
                                        <button type="button" class="button-danger" disabled="@_isSubmitting" @onclick="ReverseAsync">@Localization["Feature.match.confirmReversal"]</button>
                                    </div>
                                </div>
                            }
                        }
                        else if(!string.IsNullOrWhiteSpace(_actionState.ReverseBlockedReason))
                        {
                            <p class="match-admin-blocked-reason">@GetLocalizedAdminBlockedReason(_actionState.ReverseBlockedReason)</p>
                        }
                    </section>
                    }
                </Authorized>
            </AuthorizeView>

            @if(_isSubmitting)
            {
                <div class="match-refresh-message" role="status">@Localization["Feature.match.savingResult"]</div>
            }
        </div>
    </div>
    <UserInfoDialog User="_selectedUser" OnClose="HideUserInfoPopup" />
</CascadingValue>
