@page "/tournaments/{TournamentId:guid}"
@using Mercurius.LAN.Web.Components.Pages.Tournaments.Leaderboard
@using Mercurius.LAN.Web.Components.Pages.Tournaments.Matches.DetailView
@using Mercurius.LAN.Web.Components.Pages.Tournaments.Tabs
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Tournaments
@using Mercurius.LAN.Web.Models.Matches
@using Mercurius.LAN.Web.Models.Sponsors
@using Microsoft.AspNetCore.Components.Authorization

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@PageTitleText</PageTitle>
@if(_isLoading && _tournament is null)
{
    <LoadingScreen Message='@Localization["Feature.tournaments.loadingDetail"]' />
}
else if(_notFound)
{
    <section class="brand-section">
        <div class="brand-card tournament-empty-state" role="alert">
            <h1>@Localization["Feature.tournaments.notFoundTitle"]</h1>
            <p>@Localization["Feature.tournaments.notFoundText"]</p>
            <a class="button-secondary" href="/tournaments">@Localization["Feature.tournaments.backToTournaments"]</a>
        </div>
    </section>
}
else if(_loadError is not null && _tournament is null)
{
    <section class="brand-section">
        <div class="brand-card tournament-empty-state" role="alert">
            <h1>@Localization["Feature.tournaments.loadDetailTitle"]</h1>
            <p>@_loadError</p>
            <button type="button" class="button-primary" @onclick="RetryLoadAsync">@Localization["status.tryAgain"]</button>
        </div>
    </section>
}
else if(_tournament is null)
{
    <LoadingScreen Message='@Localization["Feature.tournaments.loadingDetail"]' />
}
else
{
    <div class="Tournament-detail-page">
        <nav class="Tournament-breadcrumb" aria-label='@Localization["Feature.tournaments.breadcrumbAria"]'>
            <a href="/">@Localization["nav.home"]</a>
            <span>/</span>
            <a href="/tournaments">@Localization["tournaments.pageTitle"]</a>
            <span>/</span>
            <span aria-current="page">@_tournament.Name</span>
        </nav>

        <header class="brand-page-hero Tournament-detail-hero brand-section">
            <div class="brand-page-hero-copy Tournament-detail-hero-copy">
                <h1>@_tournament.Name</h1>

                <div class="Tournament-detail-badges">
                    <span class="badge">@GetParticipationLabel(_tournament.ParticipationMode)</span>
                    <span class="badge">@GetBracketLabel(_tournament.BracketType)</span>
                    @if(IsLeaderboard)
                    {
                        <span class="badge">@GetLeaderboardMetricLabel()</span>
                    }
                    else
                    {
                        <span class="badge">@GetFormatLabel(_tournament.Format)</span>
                    }
                    <span class="badge Tournament-status @_tournament.Status.GetStatusClass()">@GetStatusLabel(_tournament.Status)</span>
                </div>

                <div class="Tournament-detail-hero-actions">
                    @if(IsLeaderboard)
                    {
                        <span class="Tournament-detail-registration-note">@Localization["Feature.tournaments.leaderboardNoRegistrationHero"]</span>
                    }
                    else
                    {
                        <button type="button"
                                class="button-primary @(CanRegister(_tournament) ? string.Empty : "Tournament-detail-registration-closed")"
                                disabled="@(!CanRegister(_tournament))"
                                @onclick="NavigateToRegister">
                            @(CanRegister(_tournament) ? Localization["Feature.tournaments.viewRegistrationOptions"] : Localization["Feature.tournaments.registrationClosed"])
                        </button>
                    }
                    <a href="@GetPageAnchorUrl("tournament-bracket")" class="button-secondary">@GetCompetitionActionLabel()</a>
                </div>

                <AuthorizeView Roles="admin">
                    <Authorized>
                        <div class="Tournament-admin-actions">
                            @if(_tournament.Status == TournamentStatus.Scheduled)
                            {
                                var startBlockReason = GetStartBlockReasonKey(_tournament);
                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@(IsAdminLifecycleActionPending || !CanStartTournament(_tournament))"
                                        aria-describedby="@(startBlockReason is null ? null : "tournament-start-blocked")"
                                        @onclick="StartTournamentAsync">
                                    @Localization["Feature.tournaments.start"]
                                </button>
                                @if(startBlockReason is not null)
                                {
                                    <p id="tournament-start-blocked" class="Tournament-admin-action-reason" role="status">@Localization[startBlockReason]</p>
                                }
                            }
                            @if(CanCancelTournament(_tournament))
                            {
                                <button type="button" class="btn btn-secondary" disabled="@IsAdminLifecycleActionPending" @onclick="CancelTournamentAsync">@Localization["common.cancel"]</button>
                            }
                            @if(_tournament.Status == TournamentStatus.InProgress)
                            {
                                var finishBlockReason = GetFinishBlockReasonKey(_tournament);
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled="@(IsAdminLifecycleActionPending || !CanFinishTournament(_tournament, _hasLeaderboardResults))"
                                        aria-describedby="@(finishBlockReason is null ? null : "tournament-finish-blocked")"
                                        @onclick="FinishTournamentAsync">
                                    @Localization["Feature.tournaments.finish"]
                                </button>
                                @if(finishBlockReason is not null)
                                {
                                    <p id="tournament-finish-blocked" class="Tournament-admin-action-reason" role="status">@Localization[finishBlockReason]</p>
                                }
                            }
                            @if(CanResetTournament(_tournament))
                            {
                                <button type="button" class="btn btn-secondary" disabled="@IsAdminLifecycleActionPending" @onclick="ResetTournamentAsync">@Localization["Feature.tournaments.reset"]</button>
                            }
                            <button type="button"
                                    class="btn btn-danger"
                                    disabled="@(IsAdminLifecycleActionPending || !CanDeleteTournament(_tournament))"
                                    aria-describedby="@(_tournament.Status == TournamentStatus.InProgress ? "tournament-delete-blocked" : null)"
                                    @onclick="DeleteTournamentAsync">
                                @Localization["common.delete"]
                            </button>
                            @if(_tournament.Status == TournamentStatus.InProgress)
                            {
                                <p id="tournament-delete-blocked" class="Tournament-admin-action-reason" role="status">@Localization["Feature.tournaments.deleteInProgress"]</p>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <aside class="Tournament-detail-hero-visual" aria-label='@Localization["Feature.tournaments.artworkAria"]'>
                <div class="Tournament-detail-image-frame">
                    <img src="@GetImageUrl(_tournament.ImageUrl)" alt="@_tournament.Name" class="Tournament-detail-image" />
                </div>
            </aside>
        </header>

        <div class="Tournament-detail-layout">
            <div class="Tournament-detail-top">
                <section id="tournament-overview" class="brand-card Tournament-detail-section Tournament-detail-top-section Tournament-detail-top-section--overview brand-section-anchor">
                    <TournamentOverviewTab Tournament="@_tournament" OnTournamentUpdated="HandleTournamentUpdated" />
                </section>

                @if(!IsLeaderboard)
                {
                <section id="tournament-schedule" class="brand-card Tournament-detail-section Tournament-detail-section--dense Tournament-detail-top-section Tournament-detail-top-section--schedule brand-section-anchor">
                    <div class="Tournament-section-header">
                        <div>
                            <h2 class="section-eyebrow">@Localization["Feature.tournaments.upcoming"]</h2>
                        </div>
                    </div>

                    @if(!ScheduledMatches.Any())
                    {
                        <p class="Tournament-empty-copy">@GetScheduleEmptyMessage()</p>
                    }
                    else
                    {
                        <div class="Tournament-schedule-body">
                            <div class="Tournament-schedule-filters" aria-label='@Localization["Feature.tournaments.scheduleFiltersAria"]'>
                                <div class="Tournament-schedule-filter-field">
                                    <label for="schedule-bracket-filter">@Localization["Feature.tournaments.bracket"]</label>
                                    <select id="schedule-bracket-filter"
                                            class="form-select"
                                            value="@_selectedScheduleBracket"
                                            @onchange="HandleScheduleBracketChanged">
                                        @foreach(var bracketFilter in Enum.GetValues<ScheduleBracketFilter>())
                                        {
                                            <option value="@bracketFilter">@GetScheduleBracketFilterLabel(bracketFilter)</option>
                                        }
                                    </select>
                                </div>

                                <div class="Tournament-schedule-filter-field">
                                    <label for="schedule-round-filter">@Localization["Feature.tournaments.round"]</label>
                                    <select id="schedule-round-filter"
                                            class="form-select"
                                            value="@(_selectedScheduleRound?.ToString() ?? string.Empty)"
                                            @onchange="HandleScheduleRoundChanged">
                                        <option value="">@Localization["Feature.tournaments.allRounds"]</option>
                                        @foreach(var round in AvailableScheduleRounds)
                                        {
                                            <option value="@round">@Localization.Get("Feature.tournaments.roundNumber", round)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @if(!FilteredScheduledMatches.Any())
                            {
                                <p class="Tournament-empty-copy">@Localization["Feature.tournaments.noFilteredMatches"]</p>
                            }

                            <div class="Tournament-schedule-list">
                                @foreach(var match in FilteredScheduledMatches)
                                {
                                    <article class="Tournament-schedule-item"
                                             role="button"
                                             tabindex="0"
                                             aria-label='@Localization.Get("Feature.tournaments.viewMatchDetails", GetMatchTitle(match))'
                                             @onclick="() => OpenMatchDetails(match)"
                                             @onkeydown="args => HandleScheduleItemKeyDown(args, match)">
                                        <div class="Tournament-schedule-item-main">
                                            <div class="Tournament-schedule-item-topline">
                                                <span class="Tournament-schedule-time">@GetMatchTimeRange(match)</span>
                                                <span class="Tournament-schedule-status @GetScheduleStatusClass(match)">@GetScheduleStatus(match)</span>
                                            </div>
                                            <h3>@GetMatchTitle(match)</h3>
                                            <p>@GetMatchStageSummary(match)</p>
                                        </div>

                                        <div class="Tournament-schedule-item-meta">
                                            <span class="badge">@GetRoundLabel(match)</span>
                                            <span class="badge">@GetFormatLabel(match.Format)</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>
                }

                @if(FeaturedPartner is not null)
                {
                    var partner = FeaturedPartner;
                    <section class="brand-card Tournament-detail-section Tournament-detail-partner-section Tournament-detail-top-section Tournament-detail-top-section--sponsor">
                        <a class="brand-sponsor-card Tournament-detail-partner-card" href="@partner.SponsorInfoUrl" target="_blank" rel="noopener noreferrer" aria-label='@Localization.Get("Feature.tournaments.visitPartner", partner.SponsorName)'>
                            <div class="brand-sponsor-card-logo Tournament-detail-partner-logo">
                                <img src="@GetSponsorLogoUrl(partner.SponsorLogoUrl)" alt='@Localization.Get("Feature.tournaments.partnerLogoAlt", partner.SponsorName)' />
                            </div>
                            <div class="brand-sponsor-card-body Tournament-detail-partner-copy">
                                <span class="sponsor-tier-label">@GetPartnerEyebrow(partner)</span>
                                <h2>@partner.SponsorName</h2>
                                @if(!string.IsNullOrWhiteSpace(GetFeaturedPartnerSummary(partner)))
                                {
                                    <p>@GetFeaturedPartnerSummary(partner)</p>
                                }
                                <span class="sponsor-card-link">@Localization["Feature.tournaments.visitWebsite"]</span>
                            </div>
                        </a>
                    </section>
                }

                @if(!IsLeaderboard)
                {
                <section id="tournament-participants" class="brand-card Tournament-detail-section Tournament-detail-section--dense Tournament-detail-top-section @(FeaturedPartner is null ? "Tournament-detail-top-section--participants-no-sponsor" : "Tournament-detail-top-section--participants") brand-section-anchor">
                    <TournamentParticipantsTab Tournament="@_tournament"
                                                OnTournamentUpdated="HandleTournamentUpdated"
                                                RegistrationDialogOpen="@_isRegistrationDialogOpen"
                                                RegistrationDialogOpenChanged="HandleRegistrationDialogOpenChanged" />
                </section>
                }
            </div>

            <section id="tournament-bracket" class="brand-card Tournament-detail-section Tournament-detail-section--full-span brand-section-anchor">
                @if(IsLeaderboard)
                {
                    <TournamentLeaderboardTab @key="_tournament.Status"
                                             Tournament="_tournament"
                                             OnLeaderboardChanged="HandleLeaderboardChangedAsync" />
                }
                else
                {
                    <TournamentMatchesTab OnDataReload="HandleMatchDataReloadAsync" OnMatchRefreshed="HandleMatchRefreshedAsync" Tournament="@_tournament" />
                }
            </section>

            <div class="Tournament-detail-secondary">
                <section id="tournament-results" class="brand-card Tournament-detail-section brand-section-anchor">
                    <TournamentPlacementsTab Placements="@_tournament.Placements"
                                             ParticipationMode="@_tournament.ParticipationMode"
                                             BracketType="@_tournament.BracketType"
                                             RankingMetric="@_tournament.LeaderboardRankingMetric" />
                </section>

                <AuthorizeView Roles="admin">
                    <Authorized>
                        <section id="tournament-sponsor-admin" class="brand-card Tournament-detail-section Tournament-sponsor-admin-card brand-section-anchor">
                            <div class="Tournament-section-header">
                                <div>
                                    <span class="section-eyebrow">@Localization["tournament.admin"]</span>
                                    <h2>@SponsorAdminHeading</h2>
                                    <p>@Localization["Feature.tournaments.partnerDescription"]</p>
                                </div>
                            </div>

                            @if(!_availableSponsors.Any())
                            {
                                <p class="Tournament-empty-copy">@Localization["Feature.tournaments.noSponsorsToAssign"]</p>
                            }
                            else
                            {
                                <div class="Tournament-sponsor-admin-form">
                                    <div class="form-group">
                                        <label for="tournament-sponsor">@Localization["admin.sponsors"]</label>
                                        <InputSelect id="tournament-sponsor" class="form-control" @bind-Value="_selectedSponsorId">
                                            <option value="">@Localization["Feature.tournaments.noSponsorSelected"]</option>
                                            @foreach(var sponsor in _availableSponsors)
                                            {
                                                <option value="@sponsor.Id">@sponsor.Name</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    @if(SelectedSponsor is not null)
                                    {
                                        <article class="Tournament-sponsor-admin-preview">
                                            <span class="section-eyebrow">@Localization["Feature.tournaments.preview"]</span>
                                            <h3>@SelectedSponsor.Name</h3>
                                            <p class="Tournament-sponsor-admin-preview-tier">@GetSponsorTierLabel(SelectedSponsor.SponsorTier)</p>
                                            @if(!string.IsNullOrWhiteSpace(SelectedSponsor.Description))
                                            {
                                                <p>@SelectedSponsor.Description</p>
                                            }
                                            <p class="Tournament-sponsor-admin-preview-link">@SelectedSponsor.InfoUrl</p>
                                        </article>
                                    }
                                </div>

                                <div class="Tournament-sponsor-admin-actions">
                                    @if(_sponsorError is not null)
                                    {
                                        <p class="Tournament-empty-copy" role="alert">@_sponsorError</p>
                                    }
                                    <button type="button" class="button-primary" disabled="@_isSavingSponsor" @onclick="SaveSponsorPlacementsAsync">@(_isSavingSponsor ? Localization["Feature.tournaments.saving"] : Localization["Feature.tournaments.saveSponsor"])</button>
                                </div>
                            }
                        </section>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>

    @if(_selectedMatch is not null)
    {
        <TournamentMatchDetailsDialog Match="@_selectedMatch"
                            Tournament="@_tournament"
                            Participant1Name="@GetMatchParticipantName(_selectedMatch, true)"
                            Participant2Name="@GetMatchParticipantName(_selectedMatch, false)"
                            OnClose="CloseMatchDetailsAsync"
                            OnDataReload="HandleMatchDataReloadAsync"
                            OnMatchRefreshed="HandleMatchRefreshedAsync" />
    }
}
