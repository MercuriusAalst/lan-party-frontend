@page "/tournaments"
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Components.Pages.Tournaments.Tabs
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Tournaments
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
<PageTitle>@Localization["tournaments.pageTitle"]</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["status.loadingTournaments"]' />
}
else if(_loadError is not null)
{
    <section class="brand-section">
        <div class="brand-card tournament-empty-state tournaments-load-error" role="alert">
            <span class="section-eyebrow">@Localization["tournaments.pageTitle"]</span>
            <h1>@Localization["Feature.tournamentsOverview.loadErrorTitle"]</h1>
            <p>@_loadError</p>
            <button type="button" class="button-primary" @onclick="RetryLoadAsync">@Localization["status.tryAgain"]</button>
        </div>
    </section>
}
else
{
    <section class="brand-section tournaments-browse-section">
        <div class="brand-card brand-page-hero tournaments-browse-shell">
            <div class="tournaments-browse-lead">
                <div class="brand-page-hero-copy tournaments-browse-copy">
                    <h1>@Localization["tournaments.pageTitle"]</h1>
                    <p>@Localization["Feature.tournamentsOverview.intro"]</p>
                </div>
                <SectionNav AdditionalClass="tournaments-browse-links" AriaLabel='@Localization["Feature.tournamentsOverview.sectionsAria"]'>
                    <a href="/tournaments#process" class="button-secondary">@Localization["Feature.tournamentsOverview.howItWorks"]</a>
                    <AuthorizeView Roles="admin">
                        <Authorized>
                            <a href="/admin/sponsors" class="button-secondary">@Localization["Feature.tournamentsOverview.sponsorAdmin"]</a>
                        </Authorized>
                    </AuthorizeView>
                </SectionNav>
            </div>

            <div class="tournaments-browse-controls">
                <div class="tournaments-control-field tournaments-control-field--search">
                    <label for="tournaments-search">@Localization["Feature.tournamentsOverview.searchLabel"]</label>
                    <input id="tournaments-search" type="text" class="tournaments-search-input" placeholder='@Localization["Feature.tournamentsOverview.searchPlaceholder"]' @bind="_searchTerm" @bind:event="oninput" />
                </div>

                <div class="tournaments-control-field tournaments-control-field--sort">
                    <label for="tournaments-sort">@Localization["Feature.tournamentsOverview.sortLabel"]</label>
                    <select id="tournaments-sort" class="tournaments-sort-select" @bind="_sortOption">
                        <option value="@TournamentSortOption.StartTime">@Localization["Feature.tournamentsOverview.sortStartTime"]</option>
                        <option value="@TournamentSortOption.Name">@Localization["shared.name"]</option>
                        <option value="@TournamentSortOption.Status">@Localization["tournament.status"]</option>
                    </select>
                </div>

                <div class="tournaments-filter-group">
                    <div class="tournaments-filter-group-header">
                        <span class="section-eyebrow">@Localization["tournament.status"]</span>
                    </div>
                    <div class="tournaments-filter-chip-row flex flex-wrap gap-3">
                        @foreach(var filter in StatusFilters)
                        {
                            <button type="button" class="tournaments-filter-chip @(filter.Value == _statusFilter ? "is-active" : null)" aria-pressed="@(filter.Value == _statusFilter ? "true" : "false")" @onclick="() => SetStatusFilter(filter.Value)">
                                @filter.Label
                            </button>
                        }
                    </div>
                </div>

                <div class="tournaments-filter-group">
                    <div class="tournaments-filter-group-header">
                        <span class="section-eyebrow">@Localization["tournament.participation"]</span>
                    </div>
                    <div class="tournaments-filter-chip-row flex flex-wrap gap-3">
                        @foreach(var filter in ParticipationFilters)
                        {
                            <button type="button" class="tournaments-filter-chip @(filter.Value == _participationFilter ? "is-active" : null)" aria-pressed="@(filter.Value == _participationFilter ? "true" : "false")" @onclick="() => SetParticipationFilter(filter.Value)">
                                @filter.Label
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="tournaments-grid" class="brand-section tournaments-grid-section brand-section-anchor">
        <div class="tournaments-grid grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <AuthorizeView Roles="admin">
                <Authorized>
                    <button type="button" class="brand-card tournaments-add-card" @onclick="ShowAddTournamentDialog">
                        <span class="brand-section-number">@Localization["tournament.admin"]</span>
                        <h3>@Localization["Feature.tournamentsOverview.addTournament"]</h3>
                        <p>@Localization["Feature.tournamentsOverview.addTournamentDescription"]</p>
                        <span class="tournaments-add-card-icon" aria-hidden="true">+</span>
                    </button>
                </Authorized>
            </AuthorizeView>

            @if(FilteredTournaments.Count == 0)
            {
                <div class="brand-card tournaments-empty-state">
                    <h3>@Localization["Feature.tournamentsOverview.noFilterMatches"]</h3>
                    <p>@Localization["Feature.tournamentsOverview.adjustFilters"]</p>
                </div>
            }

            @foreach(var tournament in FilteredTournaments)
            {
                var imageUrl = AssetUrlResolver.Resolve(Configuration, tournament.ImageUrl);
                <article class="brand-card brand-tournament-card tournaments-card">
                    <img src="@imageUrl" alt="@tournament.Name" class="brand-tournament-card-image tournaments-card-image" />
                    <div class="brand-tournament-card-body tournaments-card-body">
                        <div class="brand-tournament-card-topline tournaments-card-topline">
                            <span class="brand-tournament-card-date tournaments-card-date">@GetPlannedStartLabel(tournament)</span>
                            <span class="tournament-status @tournament.Status.GetStatusClass()">@GetStatusLabel(tournament.Status)</span>
                        </div>

                        <h3>@tournament.Name</h3>

                        <div class="brand-tournament-card-badges tournaments-card-badges">
                            <span class="badge">@GetParticipationLabel(tournament.ParticipationMode)</span>
                            <span class="badge">@GetBracketLabel(tournament.BracketType)</span>
                        </div>

                        <dl class="brand-tournament-card-meta tournaments-card-meta">
                            @if(tournament.BracketType != BracketType.Leaderboard)
                            {
                                <div>
                                    <dt>@Localization["tournament.format"]</dt>
                                    <dd>@GetFormatLabel(tournament.Format)</dd>
                                </div>
                                <div>
                                    <dt>@Localization["Feature.tournamentsOverview.finals"]</dt>
                                    <dd>@GetFormatLabel(tournament.FinalsFormat)</dd>
                                </div>
                            }
                            <div>
                                <dt>@Localization["Feature.tournamentsOverview.estimatedEnd"]</dt>
                                <dd>@GetEstimatedEndLabel(tournament)</dd>
                            </div>
                            @if(tournament.ParticipationMode == ParticipationMode.Team && tournament.TeamSize.HasValue)
                            {
                                <div>
                                    <dt>@Localization["tournament.teamSize"]</dt>
                                    <dd>@Localization.Get("Feature.tournament.teamSizePlayers", tournament.TeamSize)</dd>
                                </div>
                            }
                        </dl>
                    </div>

                    <div class="brand-tournament-card-actions tournaments-card-actions grid gap-3">
                        <button type="button" class="button-secondary" @onclick="() => NavigateToTournamentDetail(tournament.Id)">@Localization["Feature.tournamentsOverview.viewDetails"]</button>
                        @if(tournament.BracketType == BracketType.Leaderboard)
                        {
                            <a class="button-primary" href="@($"/tournaments/{tournament.Id}#tournament-bracket")">@Localization["Feature.tournaments.viewLeaderboard"]</a>
                        }
                        else
                        {
                            <button type="button" class="button-primary" disabled="@(!CanRegister(tournament))" @onclick="() => OpenRegistration(tournament)">
                                @(CanRegister(tournament) ? Localization["Feature.tournaments.viewRegistrationOptions"] : Localization["Feature.tournamentsOverview.registrationClosed"])
                            </button>
                        }
                    </div>
                </article>
            }
        </div>

        @if(_isLoadingPage)
        {
            <p class="tournament-empty-copy" role="status">@Localization["status.loadingTournaments"]</p>
        }

        @if(_page > 1 || _hasNextPage)
        {
            <nav class="tournaments-pagination flex items-center justify-center gap-3" aria-label='@Localization["Feature.tournamentsOverview.paginationAria"]'>
                <button type="button" class="button-secondary" disabled="@(_page == 1 || _isLoadingPage)" @onclick="() => ChangePageAsync(_page - 1)">@Localization["common.back"]</button>
                <span aria-current="page">@Localization.Get("Feature.tournamentsOverview.page", _page)</span>
                <button type="button" class="button-secondary" disabled="@(!_hasNextPage || _isLoadingPage)" @onclick="() => ChangePageAsync(_page + 1)">@Localization["common.next"]</button>
            </nav>
        }

        @if(_isAddTournamentDialogOpen)
        {
            <AddTournamentDialog OnClose="CloseAddTournamentDialog" />
        }

        @if(_registrationTournament is not null)
        {
            <TournamentParticipantsTab @key="_registrationTournament.Id"
                                       Tournament="_registrationTournament"
                                       PopupOnly="true"
                                       RegistrationDialogOpen="_isRegistrationDialogOpen"
                                       RegistrationDialogOpenChanged="HandleRegistrationDialogOpenChanged" />
        }

    </section>

    <section class="brand-section tournaments-process-section">
        <div id="process" class="tournaments-results-header tournaments-process-anchor brand-section-anchor flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <h2>@Localization["Feature.tournamentsOverview.howItWorks"]</h2>
            </div>
        </div>

        <div class="tournaments-process-grid grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <article class="brand-card tournaments-process-card">
                <h3>@Localization["Feature.tournamentsOverview.processPickHeading"]</h3>
                <p>@Localization["Feature.tournamentsOverview.processPickText"]</p>
            </article>

            <article class="brand-card tournaments-process-card">
                <h3>@Localization["Feature.tournamentsOverview.processRegisterHeading"]</h3>
                <p>@Localization["Feature.tournamentsOverview.processRegisterText"]</p>
            </article>

            <article class="brand-card tournaments-process-card">
                <h3>@Localization["Feature.tournamentsOverview.processPlayHeading"]</h3>
                <p>@Localization["Feature.tournamentsOverview.processPlayText"]</p>
            </article>
        </div>
    </section>

}

@if(_isSponsorsLoading || _sponsorsError is not null || _sponsors.Any())
{
    <section class="brand-section tournaments-sponsors">
        @if(_isSponsorsLoading)
        {
            <p class="tournament-empty-copy" role="status">@Localization["status.loadingSponsors"]</p>
        }
        else if(_sponsorsError is not null)
        {
            <p class="tournament-empty-copy" role="alert">@_sponsorsError</p>
        }
        else
        {
            <SponsorScroller Sponsors="_sponsors" AriaLabel='@Localization["Feature.tournamentsOverview.sponsorLogosAria"]' />
        }
    </section>
}

