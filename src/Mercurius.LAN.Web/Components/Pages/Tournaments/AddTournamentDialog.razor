@rendermode InteractiveServer
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Tournaments
@using Mercurius.LAN.Web.Models.Tournaments
@using Mercurius.LAN.Web.Extensions

<div>
    @if(_isDialogOpen)
    {
        <div class="Tournament-editor-modal-overlay" @onclick="() => CloseDialog(null)">
            <div class="Tournament-editor-modal-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label='@Localization["Feature.tournaments.addDialogAria"]'
                 @onclick:stopPropagation>
                <button type="button" class="Tournament-editor-modal-close" aria-label='@Localization["Feature.tournaments.closeAddDialog"]' @onclick="() => CloseDialog(null)">&times;</button>

                <div class="form-container Tournament-editor-form-container">
                    <EditForm EditContext="_editContext" OnValidSubmit="SubmitTournamentAsync" class="Tournament-editor-form">
                        <LocalizedDataAnnotationsValidator FieldLabelKeys="@ValidationFieldLabelKeys" ValidationMessageKeys="@ValidationMessageKeys" />

                        @if(_submitError is not null)
                        {
                            <div class="error-message" role="alert">
                                <p>@_submitError</p>
                            </div>
                        }

                        <div class="form-group">
                            <label for="name" class="form-label">@Localization["shared.name"]</label>
                            <InputText id="name" class="form-control" @bind-Value="_newTournament.Name" />
                            <ValidationMessage For="@(() => _newTournament.Name)"/>
                        </div>

                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="bracketType">@Localization["Feature.tournament.bracketType"]</label>
                                <InputSelect id="bracketType" class="form-control" @bind-Value="_newTournament.BracketType">
                                    @foreach(var type in SupportedBracketTypes)
                                    {
                                        <option value="@type">@GetBracketLabel(type)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.BracketType)" />
                            </div>

                            @if(IsLeaderboardSelected)
                            {
                                <div class="form-group">
                                    <label for="leaderboardRankingMetric">@Localization["Feature.tournaments.rankingMetric"]</label>
                                    <InputSelect id="leaderboardRankingMetric" class="form-control" @bind-Value="_newTournament.LeaderboardRankingMetric">
                                        <option value="">@Localization["Feature.tournaments.rankingMetricPlaceholder"]</option>
                                        @foreach(var metric in Enum.GetValues<LeaderboardRankingMetric>())
                                        {
                                            <option value="@metric">@GetRankingMetricLabel(metric)</option>
                                        }
                                    </InputSelect>
                                    <small class="form-help">@Localization["Feature.tournaments.rankingMetricHelp"]</small>
                                    <ValidationMessage For="@(() => _newTournament.LeaderboardRankingMetric)" />
                                </div>
                            }
                            else
                            {
                            <div class="form-group">
                                <label for="participationMode">@Localization["tournament.participation"]</label>
                                <InputSelect id="participationMode" class="form-control" @bind-Value="_newTournament.ParticipationMode">
                                    @foreach(ParticipationMode type in Enum.GetValues(typeof(ParticipationMode)))
                                    {
                                        <option value="@type">@GetParticipationLabel(type)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.ParticipationMode)" />
                            </div>

                            @if(_newTournament.ParticipationMode == ParticipationMode.Team)
                            {
                                <div class="form-group">
                                    <label for="teamSize">@Localization["tournament.teamSize"]</label>
                                    <InputNumber id="teamSize" class="form-control" @bind-Value="_newTournament.TeamSize" min="1" max="50" />
                                    <small class="form-help">@Localization["Feature.tournaments.teamSizeHelp"]</small>
                                    <ValidationMessage For="@(() => _newTournament.TeamSize)" />
                                </div>
                            }
                            }
                        </div>

                        @if(!IsLeaderboardSelected)
                        {
                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="format">@Localization["tournament.format"]</label>
                                <InputSelect id="format" class="form-control" @bind-Value="_newTournament.Format">
                                    @foreach(TournamentFormat type in Enum.GetValues(typeof(TournamentFormat)))
                                    {
                                        <option value="@type">@GetFormatLabel(type)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.Format)" />
                            </div>

                            <div class="form-group">
                                <label for="finalsFormat">@Localization["Feature.tournaments.finalsFormat"]</label>
                                <InputSelect id="finalsFormat" class="form-control" @bind-Value="_newTournament.FinalsFormat">
                                    @foreach(TournamentFormat type in Enum.GetValues(typeof(TournamentFormat)))
                                    {
                                        <option value="@type">@GetFormatLabel(type)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.FinalsFormat)" />
                            </div>
                        </div>
                        }
                        <div class="Tournament-editor-schedule-fields">
                            <div class="form-group">
                                <label>@Localization["Feature.tournaments.plannedStartTime"]</label>
                                <div class="Tournament-editor-datetime-row">
                                    <MudDatePicker Date="@_plannedStartDate"
                                                   DateChanged="HandlePlannedStartDateChanged"
                                                   DateFormat="dd/MM/yyyy"
                                                   Placeholder='@Localization["Feature.tournaments.datePlaceholder"]'
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="false"
                                                   Class="Tournament-editor-mud-picker" />
                                    <MudTimePicker Time="@_plannedStartTime"
                                                   TimeChanged="HandlePlannedStartTimeChanged"
                                                   AmPm="false"
                                                   TimeFormat="HH:mm"
                                                   Placeholder='@Localization["Feature.tournaments.timePlaceholder"]'
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="false"
                                                   Class="Tournament-editor-mud-picker" />
                                </div>
                                <ValidationMessage For="@(() => _newTournament.PlannedStartTime)" />
                                @if(!string.IsNullOrWhiteSpace(_plannedStartTimeError))
                                {
                                    <div class="validation-message">@_plannedStartTimeError</div>
                                }
                            </div>

                            @if(!IsLeaderboardSelected)
                            {
                            <div class="Tournament-editor-duration-row">
                                <div class="form-group">
                                    <label for="averageGameDuration">@Localization["Feature.tournaments.averageGameDuration"]</label>
                                    <InputNumber id="averageGameDuration" class="form-control" @bind-Value="_newTournament.AverageGameDurationMinutes" />
                                    <ValidationMessage For="@(() => _newTournament.AverageGameDurationMinutes)" />
                                </div>

                                <div class="form-group">
                                    <label for="roundBreakDuration">@Localization["Feature.tournaments.roundBreakDuration"]</label>
                                    <InputNumber id="roundBreakDuration" class="form-control" @bind-Value="_newTournament.RoundBreakDurationMinutes" />
                                    <ValidationMessage For="@(() => _newTournament.RoundBreakDurationMinutes)" />
                                </div>
                            </div>
                            }
                        </div>

                        <div class="form-group">
                            <label for="tournamentImage">@Localization["Feature.tournaments.tournamentImage"]</label>
                            <CustomInputFile @ref="_imageInputRef" id="tournamentImage" @bind-Value="_newTournament.Image" />
                            <ValidationMessage For="@(() => _newTournament.Image)" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="button-primary" disabled="@_isSubmitting">@(_isSubmitting ? Localization["Feature.tournaments.creating"] : Localization["Feature.tournaments.createTournament"])</button>
                            <button type="button" class="button-secondary" @onclick="() => CloseDialog(null)">@Localization["common.cancel"]</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>
