@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Registrations
@using Mercurius.LAN.Web.Models.Tournaments

<div class="participants-tab-shell">
    @if(!PopupOnly)
    {
        <div class="participants-tab-header">
            <div>
                <h2 class="section-eyebrow">@Localization["tournament.participants"]</h2>
                <p>@GetParticipantCountLabel()</p>
            </div>
        </div>
    }

    <div class="participants-overview-body">
        @if(!PopupOnly)
        {
            @if(!HasPublicParticipants)
            {
                <div class="participants-state-card" role="status">
                    <h3>@Localization["status.noParticipants"]</h3>
                    <p>@Localization["Feature.tournaments.registrationPendingBackend"]</p>
                </div>
            }
            else
            {
                <div class="participants-overview-grid">
                    @foreach(var participant in _participants)
                    {
                        <ParticipantCardComponent Participant="participant" />
                    }
                </div>
            }

        <section id="registration" class="registration-panel brand-section-anchor" aria-labelledby="registration-panel-heading">
            <div class="registration-entry">
                <div class="registration-panel-header">
                    <div>
                        <span class="section-eyebrow">@Localization["Feature.tournaments.registration"]</span>
                        <h3 id="registration-panel-heading">@(_registrationState?.PendingRosterConfirmation is null ? Localization["Feature.tournaments.joinTournament"] : Localization["Feature.tournaments.rosterInvitation"])</h3>
                        @if(Tournament.ParticipationMode == ParticipationMode.Team)
                        {
                            <p>@GetTeamRegistrationStateMessage()</p>
                        }
                    </div>
                    @if(_isLoadingRegistration)
                    {
                        <span class="registration-loading" role="status">@Localization["Feature.tournaments.checkingOptions"]</span>
                    }
                </div>

                @if(_isTeamUnregistrationConfirmationOpen &&
                    !_isRegistrationDialogOpen &&
                    CurrentCaptainManagedRegistration?.Team is { } directTeam)
                {
                    <div class="registration-inline-confirmation"
                         role="alertdialog"
                         aria-modal="false"
                         aria-labelledby="team-unregistration-confirmation-title"
                         aria-describedby="team-unregistration-confirmation-message"
                         tabindex="-1"
                         @onkeydown="HandleTeamUnregistrationConfirmationKeyDown"
                         @onkeydown:stopPropagation>
                        <div>
                            <span class="section-eyebrow">@Localization["Feature.tournaments.registration"]</span>
                            <h3 id="team-unregistration-confirmation-title">@Localization["Feature.tournaments.confirmTeamUnregister"]</h3>
                            <p id="team-unregistration-confirmation-message">@Localization.Get("Feature.tournaments.confirmTeamUnregisterMessage", directTeam.Name, Tournament.Name)</p>
                        </div>
                        <div class="registration-inline-confirmation-actions">
                            <button type="button" class="button-secondary" @onclick="KeepTeamRegistrationAsync" @ref="_teamUnregistrationKeepButtonElement">
                                @Localization["Feature.tournaments.keepRegistration"]
                            </button>
                            <button type="button" class="button-secondary registration-cancel-button" @onclick="UnregisterTeamAsync">
                                @Localization["Feature.tournaments.cancelRegistration"]
                            </button>
                        </div>
                    </div>
                }
                else if(!_isRegistrationDialogOpen &&
                    _isIndividualRegistrationConfirmationOpen &&
                    CanRegisterIndividualDirectly)
                {
                    <div class="registration-inline-confirmation registration-inline-confirmation--neutral"
                         role="alertdialog"
                         aria-modal="false"
                         aria-labelledby="individual-registration-inline-confirmation-title"
                         aria-describedby="individual-registration-inline-confirmation-message">
                        <div>
                            <span class="section-eyebrow">@Localization["Feature.tournaments.registration"]</span>
                            <h3 id="individual-registration-inline-confirmation-title">@Localization["Feature.tournaments.confirmIndividualRegistration"]</h3>
                            <p id="individual-registration-inline-confirmation-message">@Localization.Get("Feature.tournaments.confirmIndividualRegistrationMessage", Tournament.Name)</p>
                            @if(_registrationError is not null)
                            {
                                <p class="registration-message registration-message--error" role="alert">@_registrationError</p>
                            }
                        </div>
                        <div class="registration-inline-confirmation-actions">
                            <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="DismissIndividualRegistrationConfirmationAsync">
                                @Localization["common.cancel"]
                            </button>
                            <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RegisterIndividualAsync">
                                @Localization["tournament.register"]
                            </button>
                        </div>
                    </div>
                }
                else if(_registrationState?.PendingRosterConfirmation is not null)
                {
                    var selectedTeam = CurrentTeamRegistration?.Team;
                    <div class="registration-invitation" aria-labelledby="roster-invitation-summary-heading">
                        <div>
                            <span class="section-eyebrow">@Localization["Feature.tournaments.rosterInvitation"]</span>
                            <h3 id="roster-invitation-summary-heading">@Localization["Feature.tournaments.youWereSelected"]</h3>
                            <p>@Localization.Get("Feature.tournaments.rosterInvitationMessage", selectedTeam?.Name ?? Localization["Feature.tournaments.unknownTeam"], Tournament.Name)</p>
                            @if(_registrationError is not null)
                            {
                                <p class="registration-message registration-message--error" role="alert">@_registrationError</p>
                            }
                        </div>
                        <div class="registration-invitation-actions">
                            <button type="button" class="button-primary" disabled="@(!CanConfirmPending || _isSubmitting || _isLoadingRegistration)" @onclick="ConfirmRosterMemberAsync">
                                @Localization["Feature.tournaments.acceptRosterPlace"]
                            </button>
                            <button type="button" class="button-secondary registration-cancel-button" disabled="@(!CanConfirmPending || _isSubmitting || _isLoadingRegistration)" @onclick="DeclineRosterMemberAsync">
                                @Localization["Feature.tournaments.declineRosterPlace"]
                            </button>
                        </div>
                    </div>
                }
                else if(IsRegistrationOpen)
                {
                    <div class="registration-entry-actions">
                        <button type="button"
                                class="button-primary registration-open-button"
                                disabled="@(_isSubmitting || _isLoadingRegistration)"
                                @onclick="OpenRegistrationDialog">
                            <span class="bi bi-arrow-up-right-circle" aria-hidden="true"></span>
                            <span>@GetRegistrationActionLabel()</span>
                        </button>
                        @if(CanCancelTeamRegistrationDirectly)
                        {
                            <button type="button"
                                    class="button-secondary registration-cancel-button"
                                    @onclick="BeginDirectTeamUnregistrationAsync"
                                    @ref="_teamUnregistrationTriggerElement">
                                @Localization["Feature.tournaments.cancelRegistration"]
                            </button>
                        }
                    </div>
                }
                else
                {
                    <span class="registration-closed-badge" role="status">
                        <span class="bi bi-lock" aria-hidden="true"></span>
                        @Localization["Feature.tournaments.registrationClosed"]
                    </span>
                }
            </div>
        </section>
        }

        @if(_isRegistrationDialogOpen)
        {
            <div class="registration-dialog-overlay"
                 role="presentation"
                 @onclick="CloseRegistrationDialogAsync"
                 @onkeydown="HandleRegistrationDialogKeyDown">
                <div class="participants-modal-dialog registration-dialog @(Tournament.ParticipationMode == ParticipationMode.Individual ? "registration-dialog--compact" : null)"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="registration-dialog-title"
                     tabindex="-1"
                     @ref="_registrationDialogElement"
                     @onclick:stopPropagation>
                    <button type="button"
                            class="participants-modal-close"
                            aria-label='@Localization["Feature.tournaments.closeRegistration"]'
                            autofocus
                            @onclick="CloseRegistrationDialogAsync">
                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                    </button>

                    <header class="participants-modal-header registration-dialog-header">
                        <h2 id="registration-dialog-title" class="visually-hidden">@Localization.Get("Feature.tournaments.registrationFor", Tournament.Name)</h2>
                    </header>

                    <div class="registration-dialog-body">
                        @if(_isLoadingRegistration)
                        {
                            <p class="registration-message" role="status">@Localization["Feature.tournaments.checkingYourOptions"]</p>
                        }

            @if(_registrationError is not null)
            {
                <div class="registration-message registration-message--error" role="alert">
                    <p>@_registrationError</p>
                </div>
            }

            @if(_registrationWarning is not null)
            {
                <p class="registration-message registration-message--warning" role="status">@_registrationWarning</p>
            }

            @if(_isAuthenticated && IsRegistrationOpen && _registrationState?.PendingRosterConfirmation is { } pending)
            {
                var selectedTeam = CurrentTeamRegistration?.Team;
                <section class="registration-invitation" aria-labelledby="roster-invitation-heading">
                    <div>
                        <span class="section-eyebrow">@Localization["Feature.tournaments.rosterInvitation"]</span>
                        <h3 id="roster-invitation-heading">@Localization["Feature.tournaments.youWereSelected"]</h3>
                        <p>@Localization.Get("Feature.tournaments.rosterInvitationMessage", selectedTeam?.Name ?? Localization["Feature.tournaments.unknownTeam"], Tournament.Name)</p>
                    </div>
                    <div class="registration-invitation-actions">
                        <button type="button" class="button-primary" disabled="@(!CanConfirmPending || _isSubmitting || _isLoadingRegistration)" @onclick="ConfirmRosterMemberAsync">
                            @Localization["Feature.tournaments.acceptRosterPlace"]
                        </button>
                        <button type="button" class="button-secondary registration-cancel-button" disabled="@(!CanConfirmPending || _isSubmitting || _isLoadingRegistration)" @onclick="DeclineRosterMemberAsync">
                            @Localization["Feature.tournaments.declineRosterPlace"]
                        </button>
                    </div>
                </section>
            }
            else if(_isAuthenticated && IsRegistrationOpen && Tournament.ParticipationMode == ParticipationMode.Individual)
            {
                <div class="registration-workflow">
                    @if(_registrationState?.IndividualRegistration is { } individualRegistration)
                    {
                        <p class="registration-message registration-message--success">@GetIndividualRegistrationStatusText(individualRegistration.Status)</p>
                        @if(_registrationState.CanUnregister)
                        {
                            @if(_isIndividualUnregistrationConfirmationOpen && CanUnregisterIndividualDirectly)
                            {
                                <div class="registration-inline-confirmation"
                                     role="alertdialog"
                                     aria-modal="false"
                                     aria-labelledby="individual-unregistration-confirmation-title"
                                     aria-describedby="individual-unregistration-confirmation-message">
                                    <div>
                                        <span class="section-eyebrow">@Localization["Feature.tournaments.registration"]</span>
                                        <h3 id="individual-unregistration-confirmation-title">@Localization["Feature.tournaments.confirmIndividualUnregister"]</h3>
                                        <p id="individual-unregistration-confirmation-message">@Localization.Get("Feature.tournaments.confirmIndividualUnregisterMessage", Tournament.Name)</p>
                                    </div>
                                    <div class="registration-inline-confirmation-actions">
                                        <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="DismissIndividualUnregistrationConfirmationAsync">
                                            @Localization["Feature.tournaments.keepRegistration"]
                                        </button>
                                        <button type="button" class="button-secondary registration-cancel-button" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="UnregisterIndividualAsync">
                                            @Localization["Feature.tournaments.cancelRegistration"]
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="button-secondary registration-cancel-button" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="BeginIndividualUnregistrationConfirmationAsync">@Localization["Feature.tournaments.cancelRegistration"]</button>
                            }
                        }
                    }
                    else if(_individualEligibility is null)
                    {
                        <p class="registration-message" role="status">@Localization["Feature.tournaments.checkingEligibility"]</p>
                    }
                    else if(!_individualEligibility.Eligible)
                    {
                        <p class="registration-message registration-message--warning">@Localization.Get("Feature.tournaments.cannotRegisterYet", GetReasonText(_individualEligibility.ReasonCodes))</p>
                    }
                    else if(CanRegisterIndividualDirectly)
                    {
                        <div class="registration-inline-confirmation registration-inline-confirmation--flat"
                             role="alertdialog"
                             aria-modal="false"
                             aria-labelledby="individual-registration-confirmation-title"
                             aria-describedby="individual-registration-confirmation-message">
                            <div>
                                <h3 id="individual-registration-confirmation-title">@Localization["Feature.tournaments.confirmIndividualRegistration"]</h3>
                                <p id="individual-registration-confirmation-message">@Localization.Get("Feature.tournaments.confirmIndividualRegistrationMessage", Tournament.Name)</p>
                            </div>
                            <div class="registration-inline-confirmation-actions">
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="CloseRegistrationDialogAsync">
                                    @Localization["common.cancel"]
                                </button>
                                <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RegisterIndividualAsync">
                                    @Localization["tournament.register"]
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="registration-message registration-message--warning">@Localization["Feature.tournaments.registrationUnavailable"]</p>
                    }
                </div>
            }
            else if(_isAuthenticated && IsRegistrationOpen && Tournament.ParticipationMode == ParticipationMode.Team)
            {
                @if(_isTeamUnregistrationConfirmationOpen && TeamUnregistrationConfirmationRegistration?.Team is { } selectedTeam)
                {
                    <div class="registration-inline-confirmation"
                         role="alertdialog"
                         aria-modal="true"
                         aria-labelledby="team-unregistration-confirmation-title"
                         aria-describedby="team-unregistration-confirmation-message"
                         tabindex="-1"
                         @onkeydown="HandleTeamUnregistrationConfirmationKeyDown"
                         @onkeydown:stopPropagation>
                        <div>
                            <span class="section-eyebrow">@Localization["Feature.tournaments.registration"]</span>
                            <h3 id="team-unregistration-confirmation-title">@Localization["Feature.tournaments.confirmTeamUnregister"]</h3>
                            <p id="team-unregistration-confirmation-message">@Localization.Get("Feature.tournaments.confirmTeamUnregisterMessage", selectedTeam.Name, Tournament.Name)</p>
                        </div>
                        <div class="registration-inline-confirmation-actions">
                            <button type="button" class="button-secondary" @onclick="KeepTeamRegistrationAsync" @ref="_teamUnregistrationKeepButtonElement">
                                @Localization["Feature.tournaments.keepRegistration"]
                            </button>
                            <button type="button" class="button-secondary registration-cancel-button" @onclick="UnregisterTeamAsync">
                                @Localization["Feature.tournaments.cancelRegistration"]
                            </button>
                        </div>
                    </div>
                }
                else
                {
                <div class="registration-workflow registration-workflow--team">
                    @if(_teamError is not null)
                    {
                        <div class="registration-message registration-message--error" role="alert">
                            <p>@_teamError</p>
                        </div>
                    }

                    @if(_isLoadingTeams)
                    {
                        <p class="registration-message" role="status">@Localization["Feature.tournaments.loadingCaptainedTeams"]</p>
                    }
                    else if(_teamSummaryUnavailable)
                    {
                        <p class="registration-message registration-message--error" role="alert">@Localization["Feature.tournaments.teamsUnavailable"]</p>
                    }
                    else if(!RegistrableCaptainedTeams.Any())
                    {
                        @if(HasUndersizedCaptainedTeams)
                        {
                            <p class="registration-team-filter-note" role="status">@Localization.Get("Feature.tournaments.undersizedTeamsHidden", RequiredTeamSize)</p>
                        }
                        @if(CurrentTeamRegistration is { Team: not null } currentTeam && !HasCaptainManagedRegistration)
                        {
                            <div class="registration-message registration-message--warning" role="status">
                                <strong>@Localization.Get("Feature.tournaments.registeredOnTeam", currentTeam.Team.Name)</strong>
                                <p>@Localization.Get("Feature.tournaments.memberManagedRoster", GetCurrentTeamRegistrationStatusText(currentTeam.Status))</p>
                                <div class="registration-review-roster" aria-label='@Localization["Feature.tournaments.rosterConfirmationState"]'>
                                    @foreach(var member in currentTeam.RosterMembers)
                                    {
                                        <span class="registration-review-member @(member.ConfirmationStatus == RosterMemberConfirmationStatus.Pending ? "registration-review-member--pending" : "registration-review-member--confirmed")">
                                            @if(member.IsCaptain){<span class="registration-captain-chip">@Localization["Feature.tournaments.captain"]</span>}@GetUserLabel(member.User): @GetConfirmationLabel(member.ConfirmationStatus)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="registration-message registration-message--warning">@Localization["Feature.tournaments.noTeamAvailable"]</p>
                        }

                        @if(CanCancelCaptainManagedRegistration && CurrentCaptainManagedRegistration?.Team is { } managedTeam)
                        {
                            <div class="registration-entry-actions">
                                <button type="button"
                                        class="button-secondary registration-cancel-button"
                                        disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)"
                                        @onclick="() => BeginTeamUnregistrationConfirmationAsync(managedTeam.Id)"
                                        @ref="_teamUnregistrationTriggerElement">
                                    @Localization["Feature.tournaments.cancelRegistration"]
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        @if(CurrentTeamRegistration is { Team: not null } currentTeam && !HasCaptainManagedRegistration)
                        {
                            <div class="registration-message registration-message--warning" role="status">
                                <strong>@Localization.Get("Feature.tournaments.registeredOnTeam", currentTeam.Team.Name)</strong>
                                <p>@Localization.Get("Feature.tournaments.memberManagedRosterWithOtherTeams", GetCurrentTeamRegistrationStatusText(currentTeam.Status))</p>
                                <div class="registration-review-roster" aria-label='@Localization["Feature.tournaments.rosterConfirmationState"]'>
                                    @foreach(var member in currentTeam.RosterMembers)
                                    {
                                        <span class="registration-review-member @(member.ConfirmationStatus == RosterMemberConfirmationStatus.Pending ? "registration-review-member--pending" : "registration-review-member--confirmed")">
                                            @if(member.IsCaptain){<span class="registration-captain-chip">@Localization["Feature.tournaments.captain"]</span>}@GetUserLabel(member.User): @GetConfirmationLabel(member.ConfirmationStatus)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        // Derive the roster view once per render; the stepper steps and actions below read it repeatedly.
                        var rosterCandidates = EditableRosterCandidates;
                        var rosterSelectionContext = GetRosterSelectionContext();
                        var canSubmitRoster = CanSubmitRoster;
                        var canAdvanceTeamStep = CanAdvanceTeamStep;
                        <div class="registration-team-flow-heading">
                            <h3>@(HasCaptainManagedRegistration
                                ? Localization.Get("Feature.tournaments.editTeamRosterFor", SelectedTeam!.Name)
                                : Localization["Feature.tournaments.registerTeamAsCaptain"])</h3>
                            <p>@(HasCaptainManagedRegistration
                                ? Localization["Feature.tournaments.editTeamRosterHelp"]
                                : Localization["Feature.tournaments.registerTeamAsCaptainHelp"])</p>
                        </div>
                        <MudStepper
                                    ActiveIndex="@_activeTeamStep"
                                    ActiveIndexChanged="HandleTeamStepChangedAsync"
                                    OnPreviewInteraction="HandleTeamStepPreviewAsync"
                                    NonLinear="true"
                                    ShowResetButton="false"
                                    Class="registration-stepper">
                            <ChildContent>
                                <MudStep Title='@Localization["Feature.tournaments.selectTeam"]' SecondaryText='@Localization["Feature.tournaments.captainOwnedTeam"]' Completed="@(_activeTeamStep > 0)">
                                <div class="registration-step-content">
                                    @if(HasUndersizedCaptainedTeams)
                                    {
                                        <p class="registration-team-filter-note" role="status">@Localization.Get("Feature.tournaments.undersizedTeamsHidden", RequiredTeamSize)</p>
                                    }
                                    <div class="registration-team-options" role="listbox" aria-label='@Localization["Feature.tournaments.teamsYouCaptain"]'>
                                        @foreach(var team in RegistrableCaptainedTeams)
                                        {
                                            var teamEligibility = GetTeamEligibility(team.Id);
                                            var teamSelectable = CanSelectTeam(team.Id);
                                            <button type="button"
                                                    class="registration-team-option @(team.Id == _selectedTeamId ? "is-selected" : null) @(!teamSelectable ? "is-unavailable" : null)"
                                                    role="option"
                                                    aria-selected="@(team.Id == _selectedTeamId)"
                                                    aria-label='@GetTeamAriaLabel(team.Name, !teamSelectable, team.Id == _selectedTeamId)'
                                                    disabled="@(!teamSelectable || _isSubmitting || _isLoadingRegistration || _isLoadingTeams || _isLoadingRoster)"
                                                    @onclick="() => SelectTeamAsync(team.Id)">
                                                <span>
                                                    <strong>@team.Name</strong>
                                                    <small>@Localization.Get("Feature.tournaments.teamMemberCount", team.Members.Count)</small>
                                                </span>
                                                <span class="registration-team-option-meta">
                                                    @if(team.Id == _selectedTeamId)
                                                    {
                                                        <small class="registration-team-selection">
                                                            <span class="bi bi-check-circle-fill" aria-hidden="true"></span>
                                                            @Localization["Feature.tournaments.selected"]
                                                        </small>
                                                    }
                                                    @if(teamEligibility is not null && teamSelectable && IsCurrentCaptainManagedTeam(team.Id))
                                                    {
                                                        <small class="registration-team-status registration-team-status--success">@Localization["Feature.tournaments.existingRegistrationEditable"]</small>
                                                    }
                                                    else if(teamEligibility is { Eligible: false })
                                                    {
                                                        <small class="registration-team-status registration-team-status--error">@Localization["Feature.tournaments.unavailable"]</small>
                                                    }
                                                    else if(teamEligibility is { Eligible: true })
                                                    {
                                                        <small class="registration-team-status registration-team-status--success">@Localization["Feature.tournaments.eligible"]</small>
                                                    }
                                                </span>
                                            </button>
                                        }
                                    </div>

                                    @if(SelectedTeam is null)
                                    {
                                        <p class="registration-message registration-message--warning">@Localization["Feature.tournaments.selectEligibleTeam"]</p>
                                    }
                                </div>
                                </MudStep>

                                <MudStep Title='@Localization["Feature.tournaments.selectRoster"]' Disabled="@(!CanAdvanceFromTeamSelection)" Completed="@(_activeTeamStep > 1)">
                                <div class="registration-step-content">
                                    @if(SelectedTeam is not null)
                                    {
                                        <div class="registration-roster-heading">
                                            <h4 id="team-registration-roster-heading">@Localization.Get("Feature.tournaments.rosterMembersForTeam", SelectedTeam.Name)</h4>
                                            <span class="registration-roster-count" aria-label='@Localization.Get("Feature.tournaments.rosterCount", GetNormalizedRosterSelection().Count, RequiredTeamSize)'>@GetNormalizedRosterSelection().Count / @RequiredTeamSize</span>
                                        </div>

                                        <fieldset class="registration-roster-fieldset" aria-labelledby="team-registration-roster-heading">
                                            <p class="registration-help">@Localization["Feature.tournaments.captainSelectedHelp"]</p>
                                            <div class="registration-roster-list">
                                                @foreach(var member in rosterCandidates.Where(candidate => candidate.Id != SelectedTeam.CaptainUserId))
                                                {
                                                    var selected = _selectedRosterUserIds.Contains(member.Id);
                                                    var unavailable = !_isLoadingRoster && !CanSelectRosterMember(member.Id, rosterSelectionContext);
                                                    <label class="registration-roster-member @(unavailable ? "registration-roster-member--ineligible" : null) @(selected ? "is-selected" : null)">
                                                        <input type="checkbox"
                                                               checked="@selected"
                                                               disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster || unavailable)"
                                                               aria-label='@GetRosterMemberAriaLabel(member, unavailable)'
                                                               @onchange="args => ToggleRosterMemberAsync(member.Id, args)" />
                                                        <span class="registration-roster-member-copy">
                                                            <span class="registration-roster-member-name">
                                                                <strong>@GetUserLabel(member)</strong>
                                                            </span>
                                                            @if(unavailable)
                                                            {
                                                                <span class="registration-status-chip registration-status-chip--unavailable">@Localization["Feature.tournaments.unavailable"]</span>
                                                            }
                                                            else if(_isLoadingRoster)
                                                            {
                                                                <small class="registration-candidate-reason">@Localization["Feature.tournaments.checking"]</small>
                                                            }
                                                        </span>
                                                    </label>
                                                }
                                            </div>
                                        </fieldset>

                                        @if(_isLoadingRoster)
                                        {
                                            <p class="registration-message" role="status">@Localization["Feature.tournaments.checkingRosterEligibility"]</p>
                                        }
                                        else if(RequiredTeamSize <= 0)
                                        {
                                            <p class="registration-message registration-message--warning">@Localization["Feature.tournaments.invalidTeamSize"]</p>
                                        }
                                    }
                                </div>
                                </MudStep>

                                <MudStep Title='@Localization["Feature.tournaments.summary"]' SecondaryText='@Localization["Feature.tournaments.confirmRoster"]' Disabled="@(!canSubmitRoster)">
                                <div class="registration-step-content">
                                    @if(SelectedTeam is not null)
                                    {
                                        var reviewRosterUserIds = BuildRosterRequest().UserIds.ToHashSet();
                                        var confirmationByUserId = (CaptainManagedRegistration?.RosterMembers ?? [])
                                            .Where(member => member.User is not null)
                                            .ToDictionary(member => member.User!.Id, member => member.ConfirmationStatus);
                                        <div class="registration-review-summary">
                                            <div class="registration-roster-heading">
                                                <h4>@Localization["Feature.tournaments.summary"]</h4>
                                                <span class="registration-roster-count" aria-label='@Localization.Get("Feature.tournaments.rosterCount", reviewRosterUserIds.Count, RequiredTeamSize)'>@reviewRosterUserIds.Count / @RequiredTeamSize</span>
                                            </div>
                                            <strong class="registration-review-team">@SelectedTeam.Name</strong>
                                            <p class="registration-help">@Localization["Feature.tournaments.confirmationHelp"]</p>
                                            <div class="registration-review-roster registration-review-roster--cards" aria-label='@Localization["Feature.tournaments.rosterConfirmationState"]'>
                                                @foreach(var selectedMember in rosterCandidates.Where(candidate => reviewRosterUserIds.Contains(candidate.Id)))
                                                {
                                                    var confirmationStatus = confirmationByUserId.TryGetValue(selectedMember.Id, out var savedMemberStatus)
                                                        ? savedMemberStatus
                                                        : RosterMemberConfirmationStatus.Pending;
                                                    <div class="registration-review-player @(confirmationStatus == RosterMemberConfirmationStatus.Pending ? "registration-review-player--pending" : "registration-review-player--confirmed")">
                                                        <span class="registration-review-player-name">
                                                            <strong>@GetUserLabel(selectedMember)</strong>
                                                            @if(selectedMember.Id == SelectedTeam.CaptainUserId){<span class="registration-captain-chip">@Localization["Feature.tournaments.captain"]</span>}
                                                        </span>
                                                        <span class="registration-review-player-status">@GetConfirmationLabel(confirmationStatus)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                </MudStep>
                            </ChildContent>

                            <ActionContent>
                                <div class="registration-stepper-actions">
                                    @if(TeamCancellationTargetId is { } cancellationTeamId)
                                    {
                                        <button type="button"
                                                class="button-secondary registration-cancel-button"
                                                disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)"
                                                @onclick="() => BeginTeamUnregistrationConfirmationAsync(cancellationTeamId)"
                                                @ref="_teamUnregistrationTriggerElement">
                                            @Localization["Feature.tournaments.cancelRegistration"]
                                        </button>
                                    }
                                    @if(_activeTeamStep < 2)
                                    {
                                        <button type="button" class="button-primary" disabled="@(!canAdvanceTeamStep || _isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="NextTeamStepAsync">@(_activeTeamStep == 0 ? (HasCaptainManagedRegistration ? Localization["Feature.tournaments.editRoster"] : Localization["Feature.tournaments.chooseRoster"]) : Localization["Feature.tournaments.reviewRoster"])</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="button-primary" disabled="@(!canSubmitRoster || _isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="SubmitTeamRosterAsync">@(HasCaptainManagedRegistration ? Localization["tournament.saveRoster"] : Localization["tournament.confirmRegistration"])</button>
                                    }
                                </div>
                            </ActionContent>
                        </MudStepper>

                    }
                </div>
                }
            }
            else if(_isAuthenticated && !IsRegistrationOpen)
            {
                <p class="registration-message registration-message--warning">@Localization["Feature.tournaments.closedExistingActions"]</p>
            }
            else if(!_isAuthenticated)
            {
                <div class="registration-message">
                    @if(IsRegistrationOpen)
                    {
                        <p>@Localization["Feature.tournaments.signInRegistration"]</p>
                        <a class="button-primary" href="@LoginUrl">@Localization["Feature.tournaments.signInToRegister"]</a>
                    }
                    else
                    {
                        <p>@Localization["tournament.registrationClosed"]</p>
                    }
                </div>
            }

                    </div>
                </div>
            </div>
        }

        @if(!PopupOnly && _isAdmin)
        {
            <section id="admin-registration" class="registration-panel registration-panel--admin brand-section-anchor" aria-labelledby="admin-registration-heading">
                <div class="registration-panel-header">
                    <div>
                        <span class="section-eyebrow">@Localization["tournament.admin"]</span>
                        <h3 id="admin-registration-heading">@Localization["Feature.tournaments.registrationAdministration"]</h3>
                        <p>@Localization["Feature.tournaments.registrationAdministrationHelp"]</p>
                    </div>
                    @if(_isLoadingAdmin)
                    {
                        <span class="registration-loading" role="status">@Localization["tournament.loadingRegistrations"]</span>
                    }
                </div>

                @if(_adminError is not null)
                {
                    <p class="registration-message registration-message--error" role="alert">@_adminError</p>
                }
                else if(!_isLoadingAdmin && _adminRegistrations.Count == 0)
                {
                    <p class="registration-message">@Localization["tournament.noRegistrations"]</p>
                }
                else
                {
                    <div class="form-group">
                        <label for="admin-removal-reason">@Localization["Feature.tournaments.removalReason"]</label>
                        <textarea id="admin-removal-reason" class="form-control" rows="2" @bind="_adminRemovalReason"></textarea>
                    </div>
                    <div class="admin-registration-list">
                        @foreach(var registration in _adminRegistrations)
                        {
                            var registrationLabel = registration.Kind == TournamentRegistrationKind.Team
                                ? registration.Team?.Name ?? Localization["tournament.unknownTeam"]
                                : GetUserLabel(registration.User);
                            <div class="admin-registration-row">
                                <div>
                                    <strong>@registrationLabel</strong>
                                <span>@GetRegistrationKindLabel(registration.Kind) · @GetRegistrationStatusLabel(registration.Status)</span>
                                </div>
                                <button type="button" class="button-secondary" disabled="@(_pendingAdminRemovalRegistrationId.HasValue || _isLoadingRegistration)" @onclick="() => RemoveAdminRegistrationAsync(registration)">@Localization["team.remove"]</button>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>

</div>
