@page "/sponsors"
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Sponsors
@rendermode InteractiveServer

<PageTitle>@Localization["sponsors.pageTitle"]</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["status.loadingSponsors"]' />
}
else
{
    <section id="why-partners" class="brand-section brand-section-shell sponsors-impact-section brand-section-anchor">
        <div class="brand-section-shell sponsors-impact-header">
            <h1>@Localization["General.Sponsors.WhyHeading"]</h1>
        </div>

        <div class="sponsors-impact-grid">
            <article class="brand-card sponsors-impact-card">
                <h2>@Localization["General.Sponsors.StrongerExperienceHeading"]</h2>
                <p>@Localization["General.Sponsors.StrongerExperienceText"]</p>
            </article>
            <article class="brand-card sponsors-impact-card">
                <h2>@Localization["General.Sponsors.ComfortHeading"]</h2>
                <p>@Localization["General.Sponsors.ComfortText"]</p>
            </article>
            <article class="brand-card sponsors-impact-card">
                <h2>@Localization["General.Sponsors.MomentumHeading"]</h2>
                <p>@Localization["General.Sponsors.MomentumText"]</p>
            </article>
        </div>

        <div class="sponsors-impact-actions">
            <a href="/info#contact-info" class="button-primary">@Localization["General.Sponsors.BecomeSponsor"]</a>
        </div>
    </section>

    @if(!_sponsors.Any())
    {
        <section class="brand-section sponsors-empty-section">
            <div class="brand-card sponsors-empty-state">
                <span class="section-eyebrow">@Localization["General.Sponsors.Opportunities"]</span>
                <h2>@Localization["General.Sponsors.EmptyHeading"]</h2>
                <p>@Localization["General.Sponsors.EmptyText"]</p>
                <div class="sponsors-empty-actions">
                    <a href="/info#contact-info" class="button-primary">@Localization["General.Sponsors.BecomeSponsor"]</a>
                    <a href="/info" class="button-secondary">@Localization["General.Sponsors.ViewEventInfo"]</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <div id="current-partners" class="sponsors-tier-list brand-section-anchor">
            @foreach(var tier in TierOrder.Where(HasSponsorsInTier))
            {
                <section class="@GetTierSectionClass(tier)">
                    <div class="sponsors-tier-header">
                        <div class="sponsors-tier-heading">
                            <h2>@tier.GetLabel()</h2>
                        </div>
                    </div>

                    <div class="@GetTierGridClass(tier)">
                        @foreach(var sponsor in GetSponsorsByTier(tier))
                        {
                            <a class="@GetSponsorCardClass(tier)" href="@sponsor.InfoUrl" target="_blank" rel="noopener noreferrer" aria-label='@Localization.Get("General.Sponsors.VisitSponsor", sponsor.Name)'>
                                <div class="@GetSponsorCardLogoClass(tier)">
                                    <img src="@sponsor.LogoUrl" alt="@sponsor.Name logo" />
                                </div>
                                <div class="brand-sponsor-card-body sponsor-card-body">
                                    <h3>@sponsor.Name</h3>
                                    @if(ShouldShowDescription(tier) && !string.IsNullOrWhiteSpace(sponsor.Description))
                                    {
                                        <p>@sponsor.Description</p>
                                    }
                                    <span class="sponsor-card-link">
                                        @Localization["General.Sponsors.VisitWebsite"]
                                        <span class="bi bi-arrow-up-right" aria-hidden="true"></span>
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    }
}
