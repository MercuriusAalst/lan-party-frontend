@using Mercurius.LAN.Web.Components.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="authState">
                @if(authState.User.Identity?.IsAuthenticated == true)
                {
                    <PageTitle>@Localization["common.forbidden"]</PageTitle>
                    <StatusPage Eyebrow='@Localization["common.system"]' Title='@Localization["common.forbidden"]' Message='@Localization["auth.accessDenied"]' PrimaryHref="/" PrimaryLabel='@Localization["common.backHome"]' SecondaryHref="/tournaments" SecondaryLabel='@Localization["common.browseTournaments"]' />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <AuthStatusToast />
        <ProfileRedirect RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <PageTitle>@Localization["common.notFound"]</PageTitle>
            <StatusPage Eyebrow='@Localization["common.system"]' Title='@Localization["common.pageNotFound"]' Message='@Localization["common.pageMoved"]' PrimaryHref="/" PrimaryLabel='@Localization["common.backHome"]' SecondaryHref="/tournaments" SecondaryLabel='@Localization["common.browseTournaments"]' />
        </LayoutView>
    </NotFound>
</Router>
