@using Mercurius.LAN.Web.DTOs.Search

<button type="button"
        class="@GetItemClass()"
        role="option"
        aria-selected="@IsActive"
        disabled="@Disabled"
        @onclick="SelectAsync"
        @onmouseover="HoverAsync">
    <span class="@GetSearchResultIconClass(Result.Type)" aria-hidden="true"></span>
    <span class="nav-search-result-copy">
        <span class="nav-search-result-label">@GetDisplayLabel()</span>
        @if(Result.Type != GlobalSearchResultType.User && !string.IsNullOrWhiteSpace(Result.SupportingText))
        {
            <span class="nav-search-result-support">@Result.SupportingText</span>
        }
        @if(Disabled && !string.IsNullOrWhiteSpace(DisabledText))
        {
            <span class="nav-search-result-support nav-search-result-support--disabled">@DisabledText</span>
        }
    </span>
    <span class="nav-search-result-type">@GetSearchResultTypeLabel(Result.Type)</span>
</button>

@code {
    [Parameter, EditorRequired] public GlobalSearchResultDTO Result { get; set; } = null!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledText { get; set; }
    [Parameter] public string? AdditionalClass { get; set; }
    [Parameter] public EventCallback<GlobalSearchResultDTO> Selected { get; set; }
    [Parameter] public EventCallback Hovered { get; set; }

    private string GetItemClass()
    {
        var classes = "nav-search-result-item";
        if(IsActive)
            classes += " nav-search-result-item--active";

        if(!string.IsNullOrWhiteSpace(AdditionalClass))
            classes += $" {AdditionalClass}";

        return classes;
    }

    private async Task SelectAsync()
    {
        if(!Disabled)
            await Selected.InvokeAsync(Result);
    }

    private async Task HoverAsync()
    {
        if(!Disabled)
            await Hovered.InvokeAsync();
    }

    private string GetDisplayLabel() => Result.Type == GlobalSearchResultType.User
        ? string.IsNullOrWhiteSpace(Result.Username) ? Localization["shared.user"] : Result.Username.Trim()
        : Result.DisplayLabel;

    private string GetSearchResultTypeLabel(GlobalSearchResultType resultType)
    {
        return resultType switch
        {
            GlobalSearchResultType.User => Localization["search.users"],
            GlobalSearchResultType.Team => Localization["search.teams"],
            GlobalSearchResultType.Tournament => Localization["search.tournaments"],
            _ => Localization["search.viewProfile"]
        };
    }

    private static string GetSearchResultIconClass(GlobalSearchResultType resultType)
    {
        return resultType switch
        {
            GlobalSearchResultType.User => "bi bi-person-fill nav-search-result-icon nav-search-result-icon--user",
            GlobalSearchResultType.Team => "bi bi-people-fill nav-search-result-icon nav-search-result-icon--team",
            GlobalSearchResultType.Tournament => "bi bi-controller nav-search-result-icon nav-search-result-icon--tournament",
            _ => "bi bi-search nav-search-result-icon"
        };
    }
}
