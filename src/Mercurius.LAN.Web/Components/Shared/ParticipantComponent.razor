@using Mercurius.LAN.Web.DTOs.Users

@if(Participant?.User is PublicUserDTO user)
{
    <article class="participant-surface">
        @if(ShowIdentityHeader)
        {
            <header class="participant-header-row">
                <span class="participant-type">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4" /><path d="M5.5 21a7.5 7.5 0 0 1 13 0" /></svg>
                    @Localization["shared.user"]
                </span>
                <h4 class="participant-name">
                    @if(CanOpenUserInfo && CanViewUserDetails)
                    {
                        <button type="button"
                                class="participant-profile-link participant-profile-button"
                                aria-label='@Localization.Get("shared.viewDetails", GetUserLabel(user))'
                                @onclick="() => SelectUserAsync(user)">@GetUserLabel(user)</button>
                    }
                    else
                    {
                        @GetUserLabel(user)
                    }
                </h4>
            </header>
        }
        <dl class="participant-details">
            <div class="participant-detail-row">
                <dt>@Localization["shared.username"]</dt>
                <dd>
                    @if(CanOpenUserInfo && CanViewUserDetails)
                    {
                        <button type="button"
                                class="participant-profile-link participant-profile-button"
                                aria-label='@Localization.Get("shared.viewDetails", GetUserLabel(user))'
                                @onclick="() => SelectUserAsync(user)">@GetUserLabel(user)</button>
                    }
                    else
                    {
                        @GetUserLabel(user)
                    }
                </dd>
            </div>
        </dl>
    </article>
}
else if(Participant?.Team is Models.Participants.Team team)
{
    <article class="participant-surface">
        @if(ShowIdentityHeader)
        {
            <header class="participant-header-row">
                <span class="participant-type">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    @Localization["shared.team"]
                </span>
                <h4 class="participant-name">
                    @if(HasTeamName(team))
                    {
                        <TeamIdentityDisplay Name="@team.Name" LogoUrl="@team.LogoUrl" Href="@GetTeamProfileHref(team)" Variant="inline" Size="small" />
                    }
                    else
                    {
                        @Participant.DisplayName
                    }
                </h4>
            </header>
        }
        @if(team.Members.Any())
        {
            <section class="participant-section">
                <span class="participant-section-label">@Localization["shared.members"]</span>
                <div class="participant-members">
                    @foreach(var member in team.Members)
                    {
                        var isCaptain = member.Id == team.CaptainUserId;

                        @if(CanOpenUserInfo && CanViewUserDetails && isCaptain)
                        {
                            <button type="button"
                                    class="participant-member-chip participant-member-link @(isCaptain ? "participant-member-chip--captain" : null)"
                                    aria-label='@Localization.Get("shared.viewDetails", GetUserLabel(member))'
                                    @onclick="() => SelectUserAsync(member)">
                                <span>@GetUserLabel(member)</span>
                                @if(isCaptain)
                                {
                                    <span class="participant-captain-badge">@Localization["shared.captain"]</span>
                                }
                            </button>
                        }
                        else
                        {
                            <span class="participant-member-chip @(isCaptain ? "participant-member-chip--captain" : null)">
                                <span>@GetUserLabel(member)</span>
                                @if(isCaptain)
                                {
                                    <span class="participant-captain-badge">@Localization["shared.captain"]</span>
                                }
                            </span>
                        }
                    }
                </div>
            </section>
        }
    </article>
}
else
{
    <article class="participant-surface participant-surface--empty">
        <header class="participant-header-row">
            <span class="participant-type">@(string.IsNullOrWhiteSpace(EmptyLabel) ? Localization["shared.tbd"] : EmptyLabel)</span>
        </header>
        <p class="participant-empty-copy">@Localization["shared.emptyParticipant"]</p>
    </article>
}
