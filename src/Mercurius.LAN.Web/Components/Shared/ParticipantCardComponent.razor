@using Microsoft.AspNetCore.Components.Authorization

<div class="@(OnParticipantSelected.HasDelegate ? "participant-overview-card participant-overview-card--interactive" : "participant-overview-card")"
     role="@(OnParticipantSelected.HasDelegate ? "button" : null)"
     tabindex="@(OnParticipantSelected.HasDelegate ? 0 : null)"
     aria-haspopup="@(OnParticipantSelected.HasDelegate ? "dialog" : null)"
     aria-label="@(OnParticipantSelected.HasDelegate ? Localization.Get("shared.viewParticipantDetails", ParticipantLabel) : null)"
     @onmouseover="() => _showDeleteIcon = true"
     @onmouseout="() => _showDeleteIcon = false"
     @onclick="ShowParticipantPopupAsync"
     @onkeydown="HandleKeyDown">
    @if(_showDeleteIcon && AllowDeleteFunction)
    {
        <AuthorizeView Roles="admin">
            <Authorized>
                <button class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 m-2" aria-label='@Localization["shared.delete"]' @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" @onclick="async () => await OnParticipantDeleted.InvokeAsync(Participant)">
                    <i class="bi bi-trash"></i>
                </button>
            </Authorized>
        </AuthorizeView>
    }
    @if(IsTeamParticipant)
    {
        <TeamIdentityDisplay Name="@Participant.DisplayName" LogoUrl="@TeamLogoUrl" Variant="card" Size="participant-card" />
    }
    else
    {
        <div class="participant-avatar player-avatar">
            @GetParticipantInitial()
        </div>
        <div class="participant-overview-name">@ParticipantLabel</div>
    }
</div>
