@using Mercurius.LAN.Web.DTOs.Users
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if(User is { } user)
{
    <div class="user-info-dialog-overlay"
         role="presentation"
         @onclick="CloseAsync"
         @onkeydown="HandleKeyDown">
        <div class="user-info-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@DialogTitleId"
             aria-describedby="@DialogDescriptionId"
             tabindex="-1"
             @ref="_dialogElement"
             @onclick:stopPropagation>
            <button type="button"
                    class="user-info-dialog-close"
                    aria-label='@Localization["shared.closePlayerDetails"]'
                    autofocus
                    @onclick="CloseAsync">
                <span class="bi bi-x-lg" aria-hidden="true"></span>
            </button>

            <header class="user-info-dialog-header">
                <UserAvatar Name="@GetDialogTitle(user)" PictureUrl="@user.ProfilePictureUrl" Size="prominent" />
                <span class="user-info-dialog-eyebrow">@Localization["shared.playerDetails"]</span>
                <h2 id="@DialogTitleId">@GetDialogTitle(user)</h2>
                <p id="@DialogDescriptionId">@Localization["shared.sharedDetailsOnly"]</p>
            </header>

            @if(HasPublicDetails(user))
            {
                <dl class="user-info-dialog-details">
                    @if(HasValue(user.Firstname))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["profile.firstName"]</dt>
                            <dd>@user.Firstname!.Trim()</dd>
                        </div>
                    }
                    @if(HasValue(user.Lastname))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["profile.lastName"]</dt>
                            <dd>@user.Lastname!.Trim()</dd>
                        </div>
                    }
                    @if(HasValue(user.Username))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["profile.username"]</dt>
                            <dd>@user.Username!.Trim()</dd>
                        </div>
                    }
                    @if(HasValue(user.DiscordId))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["shared.discord"]</dt>
                            <dd>@user.DiscordId!.Trim()</dd>
                        </div>
                    }
                    @if(HasValue(user.SteamId))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["shared.steam"]</dt>
                            <dd>@user.SteamId!.Trim()</dd>
                        </div>
                    }
                    @if(HasValue(user.RiotId))
                    {
                        <div class="user-info-dialog-detail">
                        <dt>@Localization["shared.riot"]</dt>
                            <dd>@user.RiotId!.Trim()</dd>
                        </div>
                    }
                </dl>
            }
            else
            {
                <p class="user-info-dialog-empty">@Localization["shared.noPublicDetails"]</p>
            }
        </div>
    </div>
}
