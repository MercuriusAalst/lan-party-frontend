@if(DisplaySponsors.Count > 0)
{
    <div class="sponsor-scroller @SponsorCountClass" aria-label="@(string.IsNullOrWhiteSpace(AriaLabel) ? Localization["shared.sponsorLogos"] : AriaLabel)">
        <div class="sponsor-scroller__viewport">
            <div class="sponsor-scroller__track sponsor-scroller__track--static">
                @foreach(var sponsor in DisplaySponsors)
                {
                    <a class="sponsor-scroller__logo"
                       href="@sponsor.InfoUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@Localization.Get("shared.visitSponsor", sponsor.Name)">
                        <img src="@sponsor.LogoUrl" alt="@Localization.Get("shared.sponsorLogo", sponsor.Name)" />
                    </a>
                }
            </div>

            <div class="sponsor-scroller__track sponsor-scroller__track--marquee">
                @for(var loopIndex = 0; loopIndex < LoopCount; loopIndex++)
                {
                    var isPrimaryLoop = loopIndex == 0;

                    <div class="sponsor-scroller__loop" aria-hidden="@(!isPrimaryLoop ? "true" : "false")">
                        @foreach(var sponsor in DisplaySponsors)
                        {
                            <a class="sponsor-scroller__logo"
                               href="@sponsor.InfoUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="@(isPrimaryLoop ? Localization.Get("shared.visitSponsor", sponsor.Name) : null)"
                               tabindex="@(isPrimaryLoop ? null : "-1")">
                               <img src="@sponsor.LogoUrl" alt="@(isPrimaryLoop ? Localization.Get("shared.sponsorLogo", sponsor.Name) : string.Empty)" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
