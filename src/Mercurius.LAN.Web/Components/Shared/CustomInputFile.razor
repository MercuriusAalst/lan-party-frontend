@inherits InputBase<IBrowserFile>
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.IO
@implements IDisposable

<div class="image-upload-field">
    <label class="@GetPickerCssClass()">
        <span class="bi bi-image" aria-hidden="true"></span>
        <span>@ResolvedLabelText</span>
        <InputFile OnChange="HandleFileChange"
                   class="image-upload-native"
                   accept="@Accept"
                   @attributes="AdditionalAttributes" />
    </label>
    <small>@SelectedFileText</small>
    @if(!string.IsNullOrEmpty(_readError))
    {
        <small class="form-text text-danger" role="alert">@_readError</small>
    }
</div>

@code {
    [Inject]
    private IConfiguration Configuration { get; set; } = null!;
    [Parameter] public string LabelText { get; set; } = "";
    [Parameter] public string EmptyText { get; set; } = "";
    [Parameter] public string Accept { get; set; } = "image/png, image/jpeg, image/webp";

    private ValidationMessageStore? messageStore;
    private EditContext? _messageStoreContext;
    private long _maxFileSize;
    private string _readError = string.Empty;
    private readonly CancellationTokenSource _lifetimeCancellation = new();

    // Properties voor de metadata van het tijdelijk opgeslagen bestand
    public string? TempFilePath { get; private set; }
    public string? FileContentType { get; private set; }
    public string? FileName { get; private set; }

    private string SelectedFileText => FileName ?? (string.IsNullOrWhiteSpace(EmptyText) ? Localization["form.noFile"] : EmptyText);
    private string ResolvedLabelText => string.IsNullOrWhiteSpace(LabelText) ? Localization["shared.chooseImage"] : LabelText;

    protected override void OnInitialized()
    {
        var maxFileSizeInMb = Configuration.GetValue<int>("FileSettings:MaxFileSizeInMB");
        _maxFileSize = maxFileSizeInMb * 1024 * 1024;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if(EditContext is not null)
        {
            if(ReferenceEquals(EditContext, _messageStoreContext))
                return;

            messageStore?.Clear();
            messageStore = new ValidationMessageStore(EditContext);
            _messageStoreContext = EditContext;
        }
        else
        {
            messageStore = null;
            _messageStoreContext = null;
        }
    }

    // Dit blijft false omdat de waarde niet van een string wordt geparst
    protected override bool TryParseValueFromString(string? value, out IBrowserFile result, out string validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = null!;
        return false;
    }

    private static readonly string[] AllowedContentTypes = new[] { "image/png", "image/jpeg", "image/webp" };

    private void ClearTemporaryFile()
    {
        if(!string.IsNullOrEmpty(TempFilePath) && File.Exists(TempFilePath))
        {
            try
            {
                File.Delete(TempFilePath);
            }
            catch(IOException)
            {
            }
        }
        TempFilePath = null;
        FileContentType = null;
        FileName = null;
    }

    public void Dispose()
    {
        _lifetimeCancellation.Cancel();
        ClearTemporaryFile();
        _lifetimeCancellation.Dispose();
    }

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        messageStore?.Clear(FieldIdentifier);
        _readError = string.Empty;
        EditContext?.NotifyValidationStateChanged();
        var file = e.File;

        ClearTemporaryFile();
        CurrentValue = null;

        if(!AllowedContentTypes.Contains(file.ContentType))
        {
            ShowValidationError(Localization.Get("shared.fileTypeNotAllowed", file.ContentType));
            return;
        }

        if(file.Size > _maxFileSize)
        {
            ShowValidationError(Localization.Get("shared.fileSizeLimit", _maxFileSize / (1024 * 1024)));
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(_maxFileSize);
            TempFilePath = Path.GetTempFileName();

            using(var fs = File.Create(TempFilePath))
            {
                await stream.CopyToAsync(fs, _lifetimeCancellation.Token);
            }

            FileContentType = file.ContentType;
            FileName = file.Name;

            CurrentValue = file;
        }
        catch(Exception exception) when(exception is IOException or TimeoutException or JSException)
        {
            ClearTemporaryFile();
            CurrentValue = null;
            ShowValidationError(Localization["shared.fileReadFailed"]);
        }
        catch(OperationCanceledException) when(!_lifetimeCancellation.IsCancellationRequested)
        {
            ClearTemporaryFile();
            CurrentValue = null;
            ShowValidationError(Localization["shared.fileReadFailed"]);
        }
        catch(OperationCanceledException) when(_lifetimeCancellation.IsCancellationRequested)
        {
            ClearTemporaryFile();
            CurrentValue = null;
        }
        finally
        {
            EditContext?.NotifyFieldChanged(FieldIdentifier);
        }
    }

    private void ShowValidationError(string errorMessage)
    {
        _readError = errorMessage;
        messageStore?.Add(FieldIdentifier, errorMessage);
        EditContext?.NotifyFieldChanged(FieldIdentifier);
        EditContext?.NotifyValidationStateChanged();
    }

    protected string GetPickerCssClass()
    {
        string css = "image-upload-picker";
        if(EditContext is null || !EditContext.IsModified(FieldIdentifier))
            return css;

        bool isValid = EditContext.IsValid(FieldIdentifier);
        bool isModified = EditContext.IsModified(FieldIdentifier);

        css += $" {(isModified ? "modified " : "")}{(isValid ? "is-valid" : "is-invalid")}";
        return css;
    }
}
