@using Mercurius.LAN.Web.DTOs.Users
@using Mercurius.LAN.Web.Services
@implements IDisposable

<div class="admin-picker">
    <div class="admin-picker-input-shell">
        <span class="bi bi-search" aria-hidden="true"></span>
        <input id="@Id"
               class="form-control"
               value="@_query"
               @oninput="SetQueryAsync"
               autocomplete="off"
               spellcheck="false"
               placeholder='@Localization["Feature.tournaments.contactAdminSearchPlaceholder"]'
               aria-autocomplete="list"
               aria-expanded="@(HasDropdown ? "true" : "false")"
               aria-controls="@($"{Id}-results")" />
    </div>

    @if(HasDropdown)
    {
        <div id="@($"{Id}-results")" class="admin-picker-results" role="listbox" aria-label='@Localization["Feature.tournaments.contactAdmin"]'>
            @if(_isSearching)
            {
                <div class="admin-picker-state" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>@Localization["nav.searching"]</span>
                </div>
            }
            else if(_results.Count == 0)
            {
                <div class="admin-picker-state" aria-live="polite">@Localization["Feature.tournaments.contactAdminNoResults"]</div>
            }
            else
            {
                @foreach(var admin in _results)
                {
                    <button type="button" class="admin-picker-result" role="option" aria-selected="false" @onclick="() => SelectAsync(admin)">
                        @GetAdminLabel(admin)
                    </button>
                }
            }
        </div>
    }

    @if(_selected is not null)
    {
        <div class="admin-picker-selected">
            <span class="bi bi-person-fill" aria-hidden="true"></span>
            <span class="admin-picker-selected-label">@GetAdminLabel(_selected)</span>
            <button type="button" class="admin-picker-clear" aria-label='@Localization["Feature.tournaments.contactAdminClear"]' @onclick="ClearAsync">&times;</button>
        </div>
    }

    @if(_loadError is not null)
    {
        <div class="validation-message" role="alert">@_loadError</div>
    }
</div>

@code {
    private const int SearchDebounceMilliseconds = 300;
    private const int SearchPageSize = 50;
    private const int MinimumQueryLength = 3;

    [Inject] private ITournamentService TournamentService { get; set; } = null!;

    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public PublicUserDTO? SelectedAdmin { get; set; }
    [Parameter] public string Id { get; set; } = "adminPicker";

    private string _query = string.Empty;
    private bool _isSearching;
    private string? _loadError;
    private PublicUserDTO? _selected;
    private List<PublicUserDTO> _results = [];
    private CancellationTokenSource? _searchCancellationTokenSource;
    private long _searchRequestVersion;

    private bool HasDropdown => _query.Trim().Length >= MinimumQueryLength;

    protected override void OnParametersSet()
    {
        if(Value == _selected?.Id)
            return;

        _selected = Value.HasValue && SelectedAdmin?.Id == Value ? SelectedAdmin : null;
    }

    private async Task SetQueryAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        var trimmedQuery = _query.Trim();

        if(trimmedQuery.Length < MinimumQueryLength)
        {
            CancelPendingSearch();
            _isSearching = false;
            _loadError = null;
            _results.Clear();
            return;
        }

        await LoadAdminsAsync(trimmedQuery);
    }

    private async Task LoadAdminsAsync(string query)
    {
        CancelPendingSearch();
        _isSearching = true;
        _loadError = null;

        var requestVersion = ++_searchRequestVersion;
        _searchCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _searchCancellationTokenSource.Token;
        try
        {
            await Task.Delay(SearchDebounceMilliseconds, cancellationToken);

            var admins = await TournamentService.GetAdminUsersAsync(query, SearchPageSize, cancellationToken);
            if(cancellationToken.IsCancellationRequested || requestVersion != _searchRequestVersion)
                return;

            _results = admins;
        }
        catch(OperationCanceledException)
        {
            return;
        }
        catch(Exception)
        {
            if(cancellationToken.IsCancellationRequested || requestVersion != _searchRequestVersion)
                return;

            _results = [];
            _loadError = Localization["Feature.tournaments.contactAdminLoadFailed"];
        }
        finally
        {
            if(requestVersion == _searchRequestVersion)
                _isSearching = false;
        }
    }

    private void CancelPendingSearch()
    {
        _searchRequestVersion++;
        if(_searchCancellationTokenSource is null)
            return;

        _searchCancellationTokenSource.Cancel();
        _searchCancellationTokenSource.Dispose();
        _searchCancellationTokenSource = null;
    }

    private async Task SelectAsync(PublicUserDTO admin)
    {
        _selected = admin;
        _query = string.Empty;
        _results.Clear();
        await ValueChanged.InvokeAsync(admin.Id);
    }

    private async Task ClearAsync()
    {
        _selected = null;
        _query = string.Empty;
        _results.Clear();
        await ValueChanged.InvokeAsync(null);
    }

    private static string GetAdminLabel(PublicUserDTO admin) =>
        !string.IsNullOrWhiteSpace(admin.Username) ? admin.Username!
        : !string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.DisplayName
        : admin.Id.ToString();

    public void Dispose()
    {
        CancelPendingSearch();
    }
}
