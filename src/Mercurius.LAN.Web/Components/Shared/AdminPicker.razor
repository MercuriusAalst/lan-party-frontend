@using Mercurius.LAN.Web.DTOs.Users
@using Mercurius.LAN.Web.Services
@implements IDisposable

<div class="admin-picker">
    <select id="@Id"
            class="form-select"
            @bind:get="Value"
            @bind:set="SetValueAsync"
            aria-required="@(Required ? "true" : "false")"
            aria-busy="@(_isLoading ? "true" : "false")">
        @if(Required)
        {
            <option value="" disabled>@Localization["Feature.tournaments.contactAdminSelect"]</option>
        }
        else
        {
            <option value="">@Localization["Feature.tournaments.contactAdminNone"]</option>
        }
        @if(SelectedAdmin is { } selectedAdmin && Value == selectedAdmin.Id && !_choices.Any(admin => admin.Id == selectedAdmin.Id))
        {
            // Keep the assigned contact selectable while the list loads, fails, or omits it.
            <option value="@selectedAdmin.Id">@GetAdminLabel(selectedAdmin)</option>
        }
        @foreach(var admin in _choices)
        {
            <option value="@admin.Id">@GetAdminLabel(admin)</option>
        }
    </select>

    @if(SelectedChoice is { } selectedChoice)
    {
        <div class="admin-picker-selected">
            <UserAvatar Name="@GetAdminLabel(selectedChoice)" PictureUrl="@selectedChoice.ProfilePictureUrl" Size="compact" Decorative="true" />
            <span>@GetAdminLabel(selectedChoice)</span>
        </div>
    }

    @if(_isLoading)
    {
        <div class="admin-picker-state" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@Localization["Feature.tournaments.contactAdminLoading"]</span>
        </div>
    }
    else if(_loadError is not null)
    {
        <div class="admin-picker-state" role="alert">
            <span>@_loadError</span>
            <button type="button" class="button-secondary" @onclick="LoadAdminsAsync">@Localization["status.tryAgain"]</button>
        </div>
    }
    else if(_choices.Count == 0)
    {
        <div class="admin-picker-state" role="status">@Localization["Feature.tournaments.contactAdminNoResults"]</div>
    }
</div>

@code {
    [Inject] private ITournamentService TournamentService { get; set; } = null!;

    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public PublicUserDTO? SelectedAdmin { get; set; }
    [Parameter] public string Id { get; set; } = "adminPicker";

    /// <summary>When true the picker offers no "none" choice: an administrator must be selected.</summary>
    [Parameter] public bool Required { get; set; }

    private readonly List<PublicUserDTO> _choices = [];
    private bool _isLoading;
    private string? _loadError;
    private CancellationTokenSource? _loadCancellationTokenSource;

    protected override Task OnInitializedAsync() => LoadAdminsAsync();

    private async Task LoadAdminsAsync()
    {
        // One load at a time: a retry while loading is ignored, so a superseded load can never overwrite newer state.
        if(_isLoading)
            return;

        _loadCancellationTokenSource?.Dispose();
        var cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = cancellationTokenSource.Token;
        _loadCancellationTokenSource = cancellationTokenSource;

        _isLoading = true;
        _loadError = null;
        try
        {
            // Fetch the whole administrator list in one pass; paging stops on the last short page. Retry repeats this.
            var admins = await TournamentService.GetAllAdminUsersAsync(cancellationToken);
            _choices.Clear();
            _choices.AddRange(admins);
        }
        catch(OperationCanceledException) when(cancellationToken.IsCancellationRequested)
        {
            // Only our own cancellation (component disposal) is benign.
            return;
        }
        catch(Exception)
        {
            _loadError = Localization["Feature.tournaments.contactAdminLoadFailed"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetAdminLabel(PublicUserDTO admin) =>
        !string.IsNullOrWhiteSpace(admin.Username) ? admin.Username!
        : !string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.DisplayName
        : admin.Id.ToString();

    private Task SetValueAsync(Guid? value) => ValueChanged.InvokeAsync(value);

    private PublicUserDTO? SelectedChoice =>
        Value.HasValue
            ? _choices.FirstOrDefault(admin => admin.Id == Value.Value)
                ?? (SelectedAdmin?.Id == Value.Value ? SelectedAdmin : null)
            : null;

    public void Dispose()
    {
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
        _loadCancellationTokenSource = null;
    }
}
