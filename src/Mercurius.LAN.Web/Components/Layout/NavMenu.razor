@rendermode InteractiveServer
@if(ShouldShowInteractionOverlay)
{
    <button type="button" class="nav-overlay" @onclick="HandleOutsideClick" aria-label='@Localization["nav.closeMenus"]'></button>
}

<div class="brand-nav-shell flex w-full flex-col gap-4 md:flex-row md:items-center md:justify-between" @onclick="HandleNavShellClick">
    <nav class="brand-nav-links flex flex-col items-stretch gap-3 md:flex-1 md:flex-row md:items-center md:justify-center md:gap-5" aria-label='@Localization["nav.discover"]'>
        <NavLink href="/" Match="NavLinkMatch.All" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            @Localization["nav.home"]
        </NavLink>
        <NavLink href="/tournaments" Match="NavLinkMatch.Prefix" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            @Localization["nav.tournaments"]
        </NavLink>
        <NavLink href="/sponsors" Match="NavLinkMatch.All" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            @Localization["nav.sponsors"]
        </NavLink>
        <div class="nav-menu-group info-nav-group" @onclick:stopPropagation="true">
            <button type="button"
                    class="@GetInfoButtonClass()"
                    @onclick="ToggleInfoMenu"
                    aria-expanded="@GetAriaExpanded(_isInfoMenuVisible)"
                    aria-haspopup="true">
                @Localization["nav.info"]
                <span class="bi bi-chevron-down info-nav-caret" aria-hidden="true"></span>
            </button>
            @if(_isInfoMenuVisible)
            {
                <div class="dropdown-menu-custom info-dropdown mt-2 flex min-w-full flex-col gap-1 md:mt-0 md:min-w-[13rem]" @onclick:stopPropagation="true">
                    <NavLink href="/info" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">@Localization["nav.info.overview"]</NavLink>
                    <a href="/info#packing" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.info.packing"]</a>
                    <a href="/info#where" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.info.where"]</a>
                    <a href="/info#tickets" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.info.tickets"]</a>
                    <a href="/info#catering" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.info.catering"]</a>
                    <a href="/info#contact-info" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.info.contact"]</a>
                </div>
            }
        </div>
    </nav>

    <div id="@SearchContainerElementId" class="@GetSearchContainerClass()" role="search" aria-label='@Localization["nav.searchCommunity"]' @onclick:stopPropagation="true">
        <label class="visually-hidden" for="global-nav-search">@Localization["nav.searchLabel"]</label>
        <div class="@GetSearchInputShellClass()">
            <span class="bi bi-search nav-search-icon" aria-hidden="true"></span>
            <input id="global-nav-search"
                   class="nav-search-input"
                   type="search"
                   placeholder='@Localization["nav.searchPlaceholder"]'
                   value="@_searchQuery"
                   @oninput="HandleSearchInputAsync"
                   @onfocus="HandleSearchFocus"
                   @onkeydown="HandleSearchKeyDownAsync"
                   autocomplete="off"
                   spellcheck="false"
                   aria-label='@Localization["nav.searchLabel"]'
                   aria-autocomplete="list"
                   aria-expanded="@GetAriaExpanded(_isSearchDropdownVisible)"
                   aria-controls="global-nav-search-results" />

            @if(!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <button type="button" class="nav-search-clear-button" @onclick="ClearSearchInputAsync" aria-label='@Localization["nav.searchClear"]'>
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
            }
        </div>

        @if(_isSearchDropdownVisible)
        {
            <div id="global-nav-search-results" class="nav-search-dropdown" role="listbox" aria-label='@Localization["nav.searchResults"]' @onclick:stopPropagation="true">
                @if(_isSearchLoading)
                {
                    <div class="nav-search-state" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>@Localization["nav.searching"]</span>
                    </div>
                }
                else if(_hasSearchError)
                {
                    <div class="nav-search-state nav-search-state--error" aria-live="polite">
                        @Localization["nav.searchUnavailable"]
                    </div>
                }
                else if(!HasSearchResults)
                {
                    <div class="nav-search-state" aria-live="polite">
                        @Localization["nav.noMatches"]
                    </div>
                }
                else
                {
                    @for(var index = 0; index < _searchResults.Count; index++)
                    {
                        var result = _searchResults[index];
                        <GlobalSearchResultItem Result="result"
                                                IsActive="@(_highlightedSearchIndex == index)"
                                                Disabled="@IsSearchResultDisabled(result)"
                                                Selected="SelectSearchResultAsync"
                                                Hovered="@(() => SetSearchHighlight(index))" />
                    }
                }
            </div>
        }
    </div>

    <div class="brand-nav-actions flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-end" role="group" aria-label='@Localization["nav.accountActions"]'>
        <AuthorizeView Roles="admin">
            <Authorized>
                <div id="@AdminMenuContainerElementId" class="nav-menu-group" aria-label='@Localization["nav.organizerTools"]' @onclick:stopPropagation="true">
                    <button type="button"
                            id="@AdminMenuTriggerElementId"
                            class="@GetAdminButtonClass()"
                            @ref="_adminMenuTrigger"
                            @onclick="ToggleDropdown"
                            aria-expanded="@GetAriaExpanded(_isDropdownVisible)"
                            aria-haspopup="true"
                            aria-controls="@AdminMenuElementId">
                        @Localization["nav.admin"]
                    </button>
                    @if(_isDropdownVisible)
                    {
                        <div id="@AdminMenuElementId"
                             class="dropdown-menu-custom mt-2 flex min-w-full flex-col gap-1 md:mt-0 md:min-w-[12rem]"
                             role="menu"
                             aria-labelledby="@AdminMenuTriggerElementId"
                             @onclick:stopPropagation="true">
                            <NavLink href="/admin/sponsors" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" role="menuitem" @onclick="HandleNavigationClicked">@Localization["admin.sponsors"]</NavLink>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized Context="authState">
                <div id="@AccountMenuContainerElementId" class="nav-menu-group nav-user-widget" @onclick:stopPropagation="true">
                    <div class="nav-user-widget-controls">
                        <button type="button"
                                class="@GetUserButtonClass()"
                                @onclick="ToggleUserMenu"
                                aria-expanded="@GetAriaExpanded(_isUserMenuVisible)"
                                aria-label="@GetUserMenuAriaLabel(authState.User)">
                            <span class="user-icon bi bi-person-circle" aria-hidden="true"></span>
                            <span>@GetDisplayName(authState.User)</span>
                        </button>
                        <button type="button"
                                class="@GetNotificationButtonClass()"
                                @onclick="ToggleNotificationMenu"
                                aria-expanded="@GetAriaExpanded(_isNotificationMenuVisible)"
                                aria-label="@GetNotificationAriaLabel()">
                            <span class="bi bi-bell-fill" aria-hidden="true"></span>
                            @if(NotificationCount > 0)
                            {
                                <span class="nav-notification-badge">@NotificationCount</span>
                            }
                        </button>
                    </div>
                    @if(_isUserMenuVisible)
                    {
                        <div class="dropdown-menu-custom nav-user-menu mt-2 flex min-w-full flex-col gap-1 md:mt-0" @onclick:stopPropagation="true">
                            <NavLink href="/profile" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">@Localization["nav.profile"]</NavLink>
                            <NavLink href="/teams/manage" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">@Localization["nav.teams"]</NavLink>
                            @{
#if INCLUDE_MOCK_BACKEND
                                if(IsMockBackendEnabled && authState.User.IsInRole("admin"))
                                {
                                    <a href="@MockUserLoginHref" class="dropdown-item" @onclick="HandleNavigationClicked">@Localization["nav.devUser"]</a>
                                }
#endif
                            }
                            <button type="button" class="dropdown-item dropdown-button" @onclick="Logout">@Localization["nav.logout"]</button>
                        </div>
                    }
                    @if(_isNotificationMenuVisible)
                    {
                        <div class="dropdown-menu-custom nav-notification-dropdown mt-2 flex min-w-full flex-col gap-1 md:mt-0" @onclick:stopPropagation="true">
                            <div class="nav-notification-menu">
                                <div class="nav-notification-header">
                                    <strong>@Localization["nav.notifications"]</strong>
                                    @if(NotificationCount > 0)
                                    {
                                        <button type="button" @onclick="MarkNotificationsReadAsync">@Localization["nav.markRead"]</button>
                                    }
                                </div>
                                @if(_notificationActionError is not null)
                                {
                                    <p class="nav-notification-error" role="alert">@_notificationActionError</p>
                                }
                                @if(NotificationService.Notifications.Count == 0)
                                {
                                    <div class="nav-notification-empty">@Localization["nav.noNotifications"]</div>
                                }
                                else
                                {
                                    @foreach(var notification in NotificationService.Notifications)
                                    {
                                        <div class="@GetNotificationItemClass(notification)">
                                            <a href="@notification.Href" @onclick="HandleNavigationClicked">
                                                <span>@notification.Title</span>
                                                <small>@notification.Message</small>
                                            </a>
                                            <div class="nav-notification-actions">
                                                @if(notification.InviteId.HasValue)
                                                {
                                                    <button type="button" class="nav-notification-action nav-notification-action--accept" disabled="@IsNotificationActionPending(notification.Id)" @onclick="() => RespondToInviteNotificationAsync(notification, true)" aria-label='@Localization["nav.acceptInvitation"]'>
                                                        <span class="bi bi-check-lg" aria-hidden="true"></span>
                                                    </button>
                                                    <button type="button" class="nav-notification-action nav-notification-action--decline" disabled="@IsNotificationActionPending(notification.Id)" @onclick="() => RespondToInviteNotificationAsync(notification, false)" aria-label='@Localization["nav.declineInvitation"]'>
                                                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                                                    </button>
                                                }
                                                else if(notification.Kind == TeamNotificationKind.RosterSelection)
                                                {
                                                    <button type="button" class="nav-notification-action nav-notification-action--accept" disabled="@IsNotificationActionPending(notification.Id)" @onclick="() => RespondToRosterNotificationAsync(notification, true)" aria-label='@Localization["nav.acceptRosterSelection"]'>
                                                        <span class="bi bi-check-lg" aria-hidden="true"></span>
                                                    </button>
                                                    <button type="button" class="nav-notification-action nav-notification-action--decline" disabled="@IsNotificationActionPending(notification.Id)" @onclick="() => RespondToRosterNotificationAsync(notification, false)" aria-label='@Localization["nav.declineRosterSelection"]'>
                                                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                                                    </button>
                                                }
                                                <button type="button" class="nav-notification-action" disabled="@IsNotificationActionPending(notification.Id)" @onclick="() => DismissNotificationAsync(notification.Id)" aria-label='@Localization["nav.dismissNotification"]'>
                                                    <span class="bi bi-dash-lg" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="brand-auth-actions flex flex-col items-stretch gap-3 md:flex-row md:items-center">
                    <button type="button" class="brand-utility-button w-full justify-center md:w-auto" @onclick="BeginLogin">@Localization["nav.login"]</button>
                    <button type="button" class="brand-utility-button w-full justify-center md:w-auto" @onclick="BeginRegistration">@Localization["nav.register"]</button>
                    @{
#if INCLUDE_MOCK_BACKEND
                        if(IsMockBackendEnabled)
                        {
                            <a href="@MockAdminLoginHref" class="brand-dev-link inline-flex w-full items-center justify-center rounded-[12px] border border-[rgba(34,197,94,0.16)] px-4 py-3 text-center md:w-auto md:border-0 md:px-0 md:py-0" @onclick="HandleNavigationClicked">@Localization["nav.dev"] @Localization["nav.admin"]</a>
                        }
#endif
                    }
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <a href="/info#tickets" class="button-primary brand-ticket-cta w-full justify-center md:w-auto" @onclick="HandleNavigationClicked">
            @Localization["nav.info.tickets"]
        </a>
    </div>
</div>
