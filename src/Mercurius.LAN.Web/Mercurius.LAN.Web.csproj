<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>060acddd-9ac9-4709-869a-d4f13615ee12</UserSecretsId>
    <IncludeMockBackend Condition="'$(IncludeMockBackend)' == '' and '$(Configuration)' == 'Debug'">true</IncludeMockBackend>
    <IncludeMockBackend Condition="'$(IncludeMockBackend)' == ''">false</IncludeMockBackend>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeMockBackend)' == 'true'">
    <DefineConstants>$(DefineConstants);INCLUDE_MOCK_BACKEND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Components\Pages\Admin\Tabs\**" />
    <Compile Remove="output\**" />
    <Content Remove="Components\Pages\Admin\Tabs\**" />
    <Content Remove="output\**" />
    <EmbeddedResource Remove="Components\Pages\Admin\Tabs\**" />
    <EmbeddedResource Remove="output\**" />
    <None Remove="Components\Pages\Admin\Tabs\**" />
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <None Remove="output\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeMockBackend)' != 'true'">
    <Compile Remove="Mock\**\*.cs" />
    <Content Remove="appsettings.Local.json;MockData.Local\**;wwwroot\mock-data-local\**" />
    <None Remove="appsettings.Local.json;MockData.Local\**;wwwroot\mock-data-local\**" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazored.Toast" Version="4.2.1" />
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
		<PackageReference Include="Microsoft.Bcl.Cryptography" Version="10.0.12" />
		<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
		<PackageReference Include="MudBlazor" Version="9.4.0" />
		<PackageReference Include="Refit" Version="8.0.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />

	</ItemGroup>

</Project>
