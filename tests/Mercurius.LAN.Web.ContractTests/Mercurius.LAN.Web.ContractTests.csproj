<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IncludeMockBackend Condition="'$(IncludeMockBackend)' == '' and '$(Configuration)' == 'Debug'">true</IncludeMockBackend>
    <IncludeMockBackend Condition="'$(IncludeMockBackend)' == ''">false</IncludeMockBackend>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeMockBackend)' == 'true'">
    <DefineConstants>$(DefineConstants);INCLUDE_MOCK_BACKEND</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeMockBackend)' != 'true'">
    <Compile Remove="MockBackendParityTests.cs;MockMatchLifecycleTests.cs;MockLeaderboardParityTests.cs;MockRegistrationParityTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mercurius.LAN.Web\Mercurius.LAN.Web.csproj" />
  </ItemGroup>

</Project>
